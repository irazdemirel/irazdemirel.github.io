---
/*
  "Yazıyorum": krem rengi, pembe tuşlu retro bilgisayar (referans: referanslar/gorseller/retro-bilgisayar.jpeg).
  Ekranda yazılar terminal tarzında; klavye görünürken kendi kendine "yazar", tıklayınca tuş basılır.
*/
import { fmtDate, type Post } from '../data/content';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
// Klavye: sıralar; pembe = kenar/işlev tuşları (referanstaki gibi)
type Key = { l: string; w?: number; p?: boolean };
const rows: Key[][] = [
  [{ l: 'esc', p: true }, ...'1234567890'.split('').map((l) => ({ l })), { l: '⌫', w: 2, p: true }],
  [{ l: 'tab', w: 1.5, p: true }, ...'QWERTYUIOP'.split('').map((l) => ({ l })), { l: 'del', w: 1.5, p: true }],
  [{ l: 'caps', w: 1.8, p: true }, ...'ASDFGHJKL'.split('').map((l) => ({ l })), { l: '↵', w: 2.2, p: true }],
  [{ l: '⇧', w: 2.3, p: true }, ...'ZXCVBNM'.split('').map((l) => ({ l })), { l: '⇧', w: 2.7, p: true }],
  [{ l: 'ctrl', w: 1.5, p: true }, { l: '', w: 8 }, { l: 'alt', w: 1.5, p: true }],
];
---
<div class="retro">
  <div class="monitor">
    <div class="face">
      <div class="bezel">
        <div class="screen" data-lenis-prevent>
          <p class="prompt">C:\IRAZ\YAZILAR&gt; dir<span class="cursor" aria-hidden="true">▍</span></p>
          {posts.length === 0 ? (
            <p class="line muted">0 dosya bulundu · ilk yazı yakında</p>
          ) : (
            <ol class="files">
              {posts.map((p, i) => (
                <li>
                  <a href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>
                    <span class="n">{String(i + 1).padStart(2, '0')}</span>
                    <span class="t">{p.title}{p.external && <span aria-label="Medium'da açılır"> ↗</span>}{p.draft && <em> (taslak)</em>}</span>
                    <span class="d">{fmtDate(p.date)}</span>
                  </a>
                </li>
              ))}
            </ol>
          )}
        </div>
      </div>
      <div class="panel" aria-hidden="true">
        <span class="knob"></span>
        <span class="badge-mini"></span>
        <span class="knob"></span>
        <span class="knob small"></span>
        <span class="grill"></span>
      </div>
    </div>
    <div class="chin" aria-hidden="true">
      <span class="stripe"><i></i><i></i><i></i><i></i></span>
      <span class="slot"></span>
      <span class="btns"><i></i><i class="led"></i></span>
    </div>
  </div>
  <div class="stand" aria-hidden="true"></div>
  <div class="desk" aria-hidden="true">
    <div class="keyboard">
      {rows.map((r) => (
        <div class="krow">
          {r.map((k) => <span class:list={['kc', { pink: k.p }]} style={`--w:${k.w ?? 1}`}>{k.l}</span>)}
        </div>
      ))}
    </div>
    <div class="mouse"><span></span></div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.retro .keyboard').forEach((kb) => {
    const keys = [...kb.querySelectorAll<HTMLElement>('.kc')];
    const press = (k: HTMLElement) => { k.classList.add('down'); setTimeout(() => k.classList.remove('down'), 130); };
    keys.forEach((k) => k.addEventListener('pointerdown', () => press(k)));
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // Görünürken kendi kendine "yazar"
    let timer = 0;
    const type = () => { press(keys[Math.floor(Math.random() * keys.length)]); timer = window.setTimeout(type, 140 + Math.random() * 380); };
    new IntersectionObserver(([e]) => { clearTimeout(timer); if (e.isIntersecting) type(); }).observe(kb);
  });
</script>

<style>
  .retro {
    --cream: #efe6d6; --cream-l: #f8f2e7; --cream-d: #d9ccb6; --cream-dd: #bfae94;
    --pk: #f0a6bb; --pk-d: #d77d98;
    max-width: 680px; margin-inline: auto; position: relative;
  }
  /* Monitör: krem plastik, üstten sıcak ışık */
  .monitor {
    position: relative; border-radius: 18px 18px 10px 10px; padding: 18px 18px 0;
    background: linear-gradient(175deg, var(--cream-l), var(--cream) 45%, var(--cream-d));
    box-shadow:
      inset 0 2px 0 rgba(255,255,255,.8), inset 0 -2px 0 rgba(0,0,0,.06),
      inset 8px 0 14px -10px rgba(255,255,255,.7), inset -10px 0 16px -10px rgba(120,95,60,.35),
      0 30px 50px -28px rgba(90, 60, 40, .55), 0 2px 0 var(--cream-dd);
  }
  .face { display: grid; grid-template-columns: 1fr 64px; gap: 14px; }
  .bezel {
    border-radius: 12px; padding: 16px;
    background: linear-gradient(180deg, var(--cream-d), var(--cream) 30%, var(--cream-l));
    box-shadow: inset 0 3px 8px rgba(90,60,40,.35), inset 0 -2px 0 rgba(255,255,255,.7);
  }
  .screen {
    position: relative; aspect-ratio: 4 / 3; overflow: auto;
    border-radius: 18px / 22px; padding: 18px 20px;
    background: radial-gradient(ellipse at 50% 45%, #3d2738, #241520 70%, #170d14);
    color: #ffd6e4; font-family: var(--font-mono); font-size: 14px; line-height: 1.7;
    box-shadow: inset 0 0 40px rgba(0,0,0,.7), inset 0 0 18px rgba(255,150,190,.15), 0 0 0 3px #2a1b24;
    text-shadow: 0 0 6px rgba(255, 170, 200, .55);
  }
  /* tarama çizgileri + kavisli cam yansıması */
  .screen::before, .screen::after { content: ''; position: absolute; inset: 0; pointer-events: none; border-radius: inherit; }
  .screen::before { background: repeating-linear-gradient(0deg, rgba(0,0,0,.2) 0 1px, transparent 1px 3px); }
  .screen::after { background: linear-gradient(140deg, rgba(255,255,255,.16) 0%, rgba(255,255,255,.04) 28%, transparent 40%), radial-gradient(ellipse at 50% 50%, transparent 60%, rgba(0,0,0,.35)); }
  .prompt { margin: 0 0 10px; color: #ffb3cb; }
  .cursor { animation: blink 1s steps(1) infinite; margin-left: 2px; }
  @keyframes blink { 50% { opacity: 0; } }
  .line { margin: 0; }
  .muted { opacity: .75; }
  .files { list-style: none; margin: 0; padding: 0; }
  .files a { display: grid; grid-template-columns: 30px 1fr auto; gap: 12px; padding: 4px 6px; border-radius: 6px; color: inherit; text-decoration: none; }
  .files a:hover, .files a:focus-visible { background: rgba(255, 179, 203, .18); outline: none; }
  .files a:hover .t::before, .files a:focus-visible .t::before { content: '> '; }
  .n, .d { opacity: .6; }
  em { font-style: normal; opacity: .7; }

  /* Sağ panel: düğmeler + hoparlör ızgarası */
  .panel {
    display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 12px 0;
    border-radius: 10px; background: linear-gradient(180deg, var(--cream-d), var(--cream));
    box-shadow: inset 0 2px 4px rgba(90,60,40,.25);
  }
  .knob { width: 26px; height: 26px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #6a5a55, #2c2422 70%); box-shadow: 0 3px 4px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.2); }
  .knob.small { width: 18px; height: 18px; }
  .badge-mini { width: 22px; height: 14px; border-radius: 3px; background: #9fd0e4; box-shadow: inset 0 1px 2px rgba(0,0,0,.2); }
  .grill { width: 34px; flex: 1; min-height: 30px; border-radius: 4px; background: repeating-linear-gradient(0deg, var(--cream-dd) 0 2px, transparent 2px 6px); opacity: .7; }

  /* Alt kısım: renk şeridi, disket yuvası, düğmeler */
  .chin { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 6px 16px; }
  .stripe { display: flex; width: 34px; height: 16px; border-radius: 2px; overflow: hidden; box-shadow: 0 1px 0 rgba(255,255,255,.6); }
  .stripe i { flex: 1; } .stripe i:nth-child(1) { background: #e4555b; } .stripe i:nth-child(2) { background: #f4b03e; } .stripe i:nth-child(3) { background: #f7d64a; } .stripe i:nth-child(4) { background: #3e7cc4; }
  .slot { flex: 0 1 46%; height: 8px; border-radius: 3px; background: #6b5b4c; box-shadow: inset 0 2px 2px rgba(0,0,0,.5), 0 1px 0 rgba(255,255,255,.7); }
  .btns { display: flex; gap: 8px; align-items: center; }
  .btns i { width: 22px; height: 12px; border-radius: 3px; background: var(--cream-l); box-shadow: 0 2px 0 var(--cream-dd), inset 0 1px 0 #fff; }
  .btns .led { width: 9px; height: 9px; border-radius: 50%; background: #ff6f8f; box-shadow: 0 0 8px #ff6f8f; animation: led 2.6s ease-in-out infinite; }
  @keyframes led { 50% { opacity: .35; } }

  /* Çıkartmalar */

  .stand { width: 34%; height: 22px; margin-inline: auto; background: linear-gradient(180deg, var(--cream-dd), var(--cream-d)); clip-path: polygon(12% 0, 88% 0, 100% 100%, 0 100%); }

  /* Klavye + fare */
  .desk { display: flex; align-items: flex-end; gap: 14px; margin-top: 4px; }
  .keyboard {
    flex: 1; padding: 14px 14px 16px; border-radius: 12px 12px 16px 16px; display: grid; gap: 5px;
    background: linear-gradient(180deg, var(--cream-l), var(--cream) 50%, var(--cream-d));
    box-shadow: inset 0 2px 0 #fff, 0 6px 0 var(--cream-dd), 0 20px 30px -16px rgba(90,60,40,.5);
    transform: perspective(700px) rotateX(18deg); transform-origin: top;
  }
  .krow { display: flex; gap: 5px; }
  .kc {
    flex: var(--w) 1 0; min-width: 0; height: 28px; display: grid; place-items: center; border-radius: 5px;
    background: linear-gradient(180deg, #fffaf2, #ece2d1); color: #7a6a5c; font: 600 10px var(--font-mono);
    box-shadow: inset 0 -3px 0 rgba(120,95,60,.18), 0 3px 0 var(--cream-dd), 0 4px 3px rgba(0,0,0,.12);
    transition: transform .07s, box-shadow .07s; cursor: pointer; user-select: none; overflow: hidden;
  }
  .kc.pink { background: linear-gradient(180deg, #f8c3d1, var(--pk)); color: #7a3048; box-shadow: inset 0 -3px 0 rgba(150,50,80,.18), 0 3px 0 var(--pk-d), 0 4px 3px rgba(0,0,0,.12); }
  .kc.down { transform: translateY(2px); box-shadow: inset 0 -1px 0 rgba(120,95,60,.18), 0 1px 0 var(--cream-dd); }
  .mouse { width: 52px; height: 74px; flex: none; border-radius: 26px 26px 22px 22px; background: linear-gradient(160deg, #fffaf2, var(--cream-d)); box-shadow: 0 6px 0 var(--cream-dd), 0 14px 20px -10px rgba(90,60,40,.5); position: relative; margin-bottom: 6px; }
  .mouse span { position: absolute; inset: 0 0 50% 0; border-radius: 26px 26px 0 0; background: linear-gradient(180deg, #f8c3d1, var(--pk)); border-bottom: 2px solid var(--pk-d); }

  @media (max-width: 560px) {
    .monitor { padding: 12px 12px 0; }
    .face { grid-template-columns: 1fr 34px; gap: 8px; }
    .bezel { padding: 10px; }
    .screen { font-size: 11px; padding: 12px; aspect-ratio: 4 / 3.4; }
    .files a { grid-template-columns: 22px 1fr; gap: 8px; }
    .d { grid-column: 2; }
    .knob { width: 18px; height: 18px; } .knob.small { width: 12px; height: 12px; }
    .badge-mini { width: 16px; height: 10px; }
    .grill { width: 20px; }
    .keyboard { padding: 8px; gap: 3px; }
    .krow { gap: 3px; }
    .kc { height: 18px; font-size: 7px; border-radius: 3px; }
    .mouse { width: 32px; height: 46px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor, .btns .led { animation: none; }
    .kc { transition: none; }
  }
</style>
