---
/*
  Tema düğmesi: ipli, eski tip masa lambası.
  İpe tıkla ya da aşağı çek → ip yaylanır, ampul yanıp söner, tema değişir.
  Açık tema = lamba yanık (sıcak ışık hüzmesi), koyu tema = lamba sönük.
  Seçim localStorage'da ('tema'); ilk açılışta sistem teması (bkz. Base.astro <head>).
*/
---
<button class="lamp" type="button" aria-label="Koyu temaya geç">
  <svg viewBox="0 0 48 56" aria-hidden="true">
    <defs>
      <linearGradient id="lamp-beam" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffd59a" stop-opacity=".85" />
        <stop offset="1" stop-color="#ffd59a" stop-opacity="0" />
      </linearGradient>
      <radialGradient id="lamp-glow">
        <stop offset="0" stop-color="#ffe2b0" stop-opacity=".9" />
        <stop offset="1" stop-color="#ffe2b0" stop-opacity="0" />
      </radialGradient>
    </defs>
    <path class="beam" d="M11 25 L3 53 H45 L37 25 Z" fill="url(#lamp-beam)" />
    <circle class="glow" cx="24" cy="25" r="14" fill="url(#lamp-glow)" />
    <ellipse class="body" cx="24" cy="52.5" rx="11" ry="2.6" />
    <rect class="body" x="22.6" y="24" width="2.8" height="28" rx="1.2" />
    <circle class="bulb" cx="24" cy="25" r="4.2" />
    <path class="shade" d="M8 25 C8 11 40 11 40 25 Z" />
    <g class="cord">
      <line x1="34" y1="24" x2="34" y2="37" />
      <circle cx="34" cy="39" r="2.3" />
    </g>
  </svg>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.lamp');
  if (btn) {
    const root = document.documentElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sync = () => {
      const dark = root.dataset.theme === 'dark';
      btn.setAttribute('aria-label', dark ? 'Açık temaya geç' : 'Koyu temaya geç');
      btn.classList.toggle('off', dark);
    };
    sync();

    // Kullanıcı seçim yapmadıysa sistem teması değişince ona uy
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      let saved = null;
      try { saved = localStorage.getItem('tema'); } catch {}
      if (!saved) { root.dataset.theme = e.matches ? 'dark' : 'light'; sync(); }
    });

    // İpi aşağı çekme (sürükleme); bırakınca click olur → tema değişir
    let startY: number | null = null;
    btn.addEventListener('pointerdown', (e) => { startY = e.clientY; });
    btn.addEventListener('pointermove', (e) => {
      if (startY === null || reduce) return;
      btn.style.setProperty('--pull', `${Math.min(10, Math.max(0, e.clientY - startY))}px`);
    });
    const release = () => { startY = null; btn.style.removeProperty('--pull'); };
    btn.addEventListener('pointerup', release);
    btn.addEventListener('pointercancel', release);

    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem('tema', next); } catch {}
      if (!reduce) {
        // ip yaylanır + ampul titrer; renkler yumuşak geçer
        btn.classList.remove('pulled'); void btn.offsetWidth; btn.classList.add('pulled');
        root.classList.add('theme-anim');
        setTimeout(() => root.classList.remove('theme-anim'), 650);
      }
      root.dataset.theme = next;
      sync();
    });
  }
</script>

<style>
  .lamp {
    flex: none; width: 44px; height: 52px; padding: 0; margin: 0;
    background: none; border: 0; border-radius: 12px; cursor: pointer; color: var(--text);
    touch-action: none; -webkit-tap-highlight-color: transparent;
  }
  .lamp:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 2px; }
  svg { width: 100%; height: 100%; overflow: visible; }
  .body { fill: currentColor; }
  .shade { fill: var(--accent); stroke: currentColor; stroke-width: 1.4; stroke-linejoin: round; }
  .bulb { fill: #ffe7b8; transition: fill .3s; }
  .beam, .glow { transition: opacity .4s; }
  .cord { stroke: currentColor; stroke-width: 1.3; fill: currentColor; transform: translateY(var(--pull, 0)); transition: transform .15s; }

  /* Sönük (koyu tema) */
  .lamp.off .bulb { fill: var(--muted); }
  .lamp.off .beam, .lamp.off .glow { opacity: 0; }

  .lamp.pulled .cord { animation: lamp-spring .7s cubic-bezier(.3,.7,.3,1); }
  .lamp.pulled .bulb, .lamp.pulled .glow { animation: lamp-flicker .45s steps(1, end); }
  @keyframes lamp-spring {
    0% { transform: translateY(0); }
    25% { transform: translateY(9px); }
    50% { transform: translateY(-3px); }
    70% { transform: translateY(1.5px); }
    100% { transform: translateY(0); }
  }
  @keyframes lamp-flicker {
    0%, 40%, 80% { opacity: 1; }
    20%, 60% { opacity: .25; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cord, .bulb, .beam, .glow { transition: none; animation: none !important; }
  }
</style>
