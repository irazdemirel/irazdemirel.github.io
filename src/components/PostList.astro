---
// Numaralı blog listesi (referans: Kumo'daki 01/02/03 listesi)
import { fmtDate, type Post } from '../data/content';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
{posts.length === 0 ? (
  <p class="empty">İlk yazı yakında burada.</p>
) : (
  <ol class="list">
    {posts.map((p, i) => (
      <li class="reveal">
        <a href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>
          <span class="label n">{String(i + 1).padStart(2, '0')}</span>
          <span class="t">{p.title}{p.external && <span class="ext" aria-label="Medium'da açılır"> ↗</span>}{p.draft && <em class="label"> taslak</em>}</span>
          <span class="label tag">{p.external ? `${p.tag === 'medium' ? '' : p.tag + ' · '}medium` : p.tag}</span>
          <span class="label d">{fmtDate(p.date)}</span>
        </a>
      </li>
    ))}
  </ol>
)}

<style>
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  a {
    display: grid; grid-template-columns: 48px 1fr auto 160px; gap: 16px; align-items: baseline;
    padding: 18px 0; border-bottom: 1px solid var(--line); text-decoration: none;
  }
  .t { font-size: clamp(18px, 2.2vw, 24px); font-weight: 500; letter-spacing: -0.01em; }
  a:hover .t { text-decoration: underline; text-underline-offset: 4px; }
  .d { text-align: right; }
  em { font-style: normal; }
  .ext { color: var(--muted); font-weight: 400; }
  @media (max-width: 640px) {
    a { grid-template-columns: 32px 1fr; row-gap: 4px; }
    .tag, .d { grid-column: 2; text-align: left; }
  }
</style>
