---
/*
  İletişim: büyük pembe retro telefon ahizesi. Arada "çalar" (titrer, ses çizgileri),
  kıvırcık kablosu sallanır. Tıklayınca e-posta açılır.
*/
interface Props { href: string; }
const { href } = Astro.props;
// Kıvırcık kablo: sarmal halkalar
const coil = Array.from({ length: 6 }, (_, i) => `q 14 ${6} 0 12 q -14 ${6} 0 12`).join(' ');
---
<a class="phone" href={href} aria-label="Bana e-posta gönder">
  <span class="bubble" aria-hidden="true">Ara beni ♡</span>
  <svg viewBox="0 0 220 440" aria-hidden="true">
    <defs>
      <linearGradient id="ph-body" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ffc4d4" />
        <stop offset=".5" stop-color="#f48fb0" />
        <stop offset="1" stop-color="#d9628a" />
      </linearGradient>
    </defs>
    <!-- ses çizgileri -->
    <g class="rings" fill="none" stroke="var(--accent-strong)" stroke-width="5" stroke-linecap="round">
      <path d="M150 30 q 22 10 26 34" /><path d="M162 10 q 34 16 38 56" />
      <path d="M40 200 q -24 -8 -30 -32" /><path d="M30 222 q -34 -12 -42 -52" />
    </g>
    <g class="handset">
      <!-- sap -->
      <path d="M78 70 C 150 120, 150 210, 78 262" fill="none" stroke="url(#ph-body)" stroke-width="44" stroke-linecap="round" />
      <!-- kulaklık ve ağızlık -->
      <g transform="rotate(-28 70 66)"><rect x="22" y="40" width="98" height="52" rx="26" fill="url(#ph-body)" /><g fill="#c9547c" opacity=".55"><circle cx="58" cy="66" r="4" /><circle cx="71" cy="60" r="4" /><circle cx="71" cy="72" r="4" /><circle cx="84" cy="66" r="4" /></g></g>
      <g transform="rotate(28 70 266)"><rect x="22" y="240" width="98" height="52" rx="26" fill="url(#ph-body)" /><g fill="#c9547c" opacity=".55"><circle cx="58" cy="266" r="4" /><circle cx="71" cy="260" r="4" /><circle cx="71" cy="272" r="4" /><circle cx="84" cy="266" r="4" /></g></g>
      <!-- parlama -->
      <path d="M96 96 C 132 128, 134 186, 104 226" fill="none" stroke="#fff" stroke-opacity=".6" stroke-width="7" stroke-linecap="round" />
      <path d="M40 52 l 30 -14" stroke="#fff" stroke-opacity=".7" stroke-width="6" stroke-linecap="round" />
    </g>
    <!-- kıvırcık kablo -->
    <path class="cord" d={`M74 288 ${coil}`} fill="none" stroke="#e57aa0" stroke-width="5" stroke-linecap="round" />
  </svg>
</a>

<style>
  .phone { position: relative; display: block; width: min(260px, 60vw); margin-inline: auto; text-decoration: none; -webkit-tap-highlight-color: transparent; }
  .phone svg { width: 100%; overflow: visible; display: block; filter: drop-shadow(0 18px 22px rgba(160, 60, 100, .35)); }
  .handset { transform-origin: 90px 160px; animation: cal 4.5s ease-in-out infinite; }
  .rings { opacity: 0; animation: ses 4.5s ease-out infinite; }
  .cord { transform-origin: 74px 288px; animation: kablo 3s ease-in-out infinite alternate; }
  @keyframes cal {
    0%, 70%, 100% { transform: rotate(0); }
    72%, 76%, 80%, 84% { transform: rotate(-7deg) translateY(-4px); }
    74%, 78%, 82%, 86% { transform: rotate(7deg) translateY(-4px); }
    88% { transform: rotate(0); }
  }
  @keyframes ses { 0%, 70% { opacity: 0; } 74%, 86% { opacity: 1; } 92%, 100% { opacity: 0; } }
  @keyframes kablo { from { transform: rotate(-4deg); } to { transform: rotate(5deg) scaleY(1.04); } }
  .phone:hover .handset, .phone:focus-visible .handset { animation: cal-hizli .5s ease-in-out infinite; }
  .phone:hover .rings, .phone:focus-visible .rings { animation: none; opacity: 1; }
  @keyframes cal-hizli { 25% { transform: rotate(-6deg) translateY(-6px); } 75% { transform: rotate(6deg) translateY(-6px); } }
  .phone:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 8px; border-radius: 20px; }
  .bubble {
    position: absolute; top: 2%; right: -4%; z-index: 1; padding: 10px 16px; border-radius: 20px 20px 20px 4px;
    background: #fff; color: var(--accent-strong); font-weight: 800; font-size: 18px; white-space: nowrap;
    box-shadow: 0 10px 20px -10px rgba(160,60,100,.45); rotate: 6deg; animation: balon 3s ease-in-out infinite;
  }
  :global([data-theme='dark']) .bubble { background: var(--surface); }
  @keyframes balon { 50% { translate: 0 -8px; rotate: 2deg; } }
  @media (prefers-reduced-motion: reduce) {
    .handset, .rings, .cord, .bubble, .phone:hover .handset { animation: none; }
  }
</style>
