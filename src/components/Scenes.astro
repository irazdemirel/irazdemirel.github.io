---
// İzlediklerim: film → sinema salonu, dizi → oturma odası ekranı, tiyatro/konser → sahne.
import type { Post } from '../data/content';
interface Props { items: Post[]; }
const { items } = Astro.props;
const scenes = [
  { id: 'sinema', label: 'Sinema', hint: 'Filmler', tags: ['film'] },
  { id: 'ekran', label: 'Ekran', hint: 'Diziler', tags: ['dizi'] },
  { id: 'sahne', label: 'Sahne', hint: 'Tiyatro · Konser', tags: ['tiyatro', 'konser'] },
].map((s) => ({ ...s, list: items.filter((i) => s.tags.includes(i.tag)) }));
---
<div class="scenes" data-scenes>
  <div class="tabs" role="tablist">
    {scenes.map((s, i) => (
      <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`sc-${s.id}`} data-tab={s.id}>
        {s.label} <span class="label">{s.hint}</span>
      </button>
    ))}
  </div>

  {scenes.map((s, i) => (
    <div id={`sc-${s.id}`} role="tabpanel" class:list={['scene', s.id]} hidden={i !== 0}>
      {s.id === 'sahne' && <><div class="curtain l" /><div class="curtain r" /><div class="valance" /><div class="spot s1" /><div class="spot s2" /></>}
      <div class="screen">
        {s.list.length === 0 ? <p class="none label">Henüz yok</p> : (
          <ul class="posters">
            {s.list.map((p) => (
              <li>
                <a href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined} style={p.color ? `--c:${p.color}` : ''} title={p.title}>
                  {p.cover ? <img src={p.cover} alt="" loading="lazy" /> : <span class="pt">{p.title}</span>}
                  <span class="cap"><b>{p.title}</b>{p.creator && <span>{p.creator}</span>}{p.draft && <em>taslak</em>}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      {s.id === 'sinema' && <div class="seats" aria-hidden="true">{Array.from({ length: 2 }, () => <div class="row">{Array.from({ length: 14 }, () => <span />)}</div>)}</div>}
      {s.id === 'ekran' && <><div class="stand" aria-hidden="true" /><div class="sofa" aria-hidden="true"><span /></div></>}
      {s.id === 'sahne' && <div class="floor" aria-hidden="true" />}
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-scenes]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        root.querySelector<HTMLElement>(`#sc-${x.dataset.tab}`)!.hidden = !on;
      });
    }));
  });
</script>

<style>
  .tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
  .tabs button {
    font: inherit; font-weight: 500; cursor: pointer; padding: 10px 18px; border-radius: 999px;
    background: transparent; color: var(--text); border: 1px solid var(--line);
  }
  .tabs button .label { margin-left: 6px; }
  .tabs button[aria-selected='true'] { background: var(--accent); color: var(--accent-contrast); border-color: var(--accent); }
  .tabs button[aria-selected='true'] .label { color: inherit; opacity: .7; }

  .scene { position: relative; border-radius: var(--radius); overflow: hidden; padding: 40px 6% 0; min-height: 440px; display: flex; flex-direction: column; align-items: center; }
  .scene[hidden] { display: none; }
  .screen { position: relative; z-index: 2; width: 100%; aspect-ratio: 2.2 / 1; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .posters { list-style: none; margin: 0; padding: 0 16px; display: flex; gap: 14px; overflow-x: auto; max-width: 100%; }
  .posters a {
    display: block; position: relative; width: 150px; aspect-ratio: 2 / 3; border-radius: 6px; overflow: hidden;
    background: var(--c, color-mix(in srgb, var(--text) 30%, var(--bg))); color: #fff; text-decoration: none;
    transition: transform .3s; box-shadow: 0 10px 20px -10px rgba(0,0,0,.6);
  }
  .posters a:hover, .posters a:focus-visible { transform: translateY(-6px) scale(1.04); outline: none; }
  .posters img { width: 100%; height: 100%; object-fit: cover; }
  .pt { position: absolute; inset: 12px; font-family: var(--font-display); font-weight: 700; font-size: 17px; line-height: 1.1; }
  .cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 8px; display: flex; flex-direction: column; font-size: 11px; background: linear-gradient(transparent, rgba(0,0,0,.75)); }
  .cap b { display: none; }
  .cap em { font-style: normal; font-family: var(--font-mono); opacity: .7; }
  .none { color: inherit; opacity: .6; }

  /* SİNEMA: karanlık salon, parlayan perde, koltuk sıraları */
  .sinema { background: #0d0d0d; color: #eee; }
  .sinema .screen { background: #1b1b1b; border-radius: 6px 6px 40% 40% / 6px 6px 8% 8%; box-shadow: 0 0 80px 10px rgba(255,255,255,.08), 0 30px 60px rgba(255,255,255,.04); }
  .seats { width: 112%; margin-top: auto; padding-top: 28px; }
  .seats .row { display: flex; justify-content: center; gap: 6px; margin-top: -6px; }
  .seats .row:last-child { transform: scale(1.12); transform-origin: top; }
  .seats span { width: 6%; height: 54px; background: #222; border-radius: 14px 14px 0 0; box-shadow: inset 0 6px 0 #2c2c2c; }

  /* EKRAN: oturma odası, televizyon, kanepe */
  .ekran { background: var(--surface); }
  .ekran .screen { width: 62%; aspect-ratio: 16 / 9; background: #111; border: 10px solid #1f1f1f; border-radius: 10px; color: #eee; }
  .stand { width: 18%; height: 18px; margin-bottom: 24px; background: #1f1f1f; border-radius: 0 0 6px 6px; }
  .sofa { position: relative; margin-top: auto; width: 66%; height: 64px; background: color-mix(in srgb, var(--text) 18%, var(--surface)); border-radius: 26px 26px 0 0; }
  .sofa span { position: absolute; left: -4%; right: -4%; bottom: 0; height: 44px; background: color-mix(in srgb, var(--text) 26%, var(--surface)); border-radius: 22px 22px 0 0; }

  /* SAHNE: perde, saçak, spot ışıkları */
  .sahne { background: #121212; color: #eee; }
  .sahne .screen { background: radial-gradient(ellipse at 50% 100%, #2a2a2a, #161616 70%); }
  .curtain { position: absolute; top: 0; bottom: 0; width: 13%; z-index: 3; background: repeating-linear-gradient(90deg, #3a3a3a 0 14px, #2a2a2a 14px 28px); }
  .curtain.l { left: 0; border-radius: 0 0 60% 0; }
  .curtain.r { right: 0; border-radius: 0 0 0 60%; }
  .valance { position: absolute; top: 0; left: 0; right: 0; height: 34px; z-index: 4; background: radial-gradient(circle at 20px -6px, #3a3a3a 24px, transparent 25px) 0 0 / 40px 34px repeat-x; }
  .spot { position: absolute; top: 0; width: 34%; height: 90%; z-index: 1; background: linear-gradient(rgba(255,255,255,.12), transparent); clip-path: polygon(45% 0, 55% 0, 100% 100%, 0 100%); }
  .s1 { left: 18%; transform: rotate(12deg); transform-origin: top; }
  .s2 { right: 18%; transform: rotate(-12deg); transform-origin: top; }
  .floor { margin-top: auto; width: 120%; height: 60px; background: linear-gradient(#2a2a2a, #1a1a1a); }

  @media (max-width: 640px) {
    .scene { min-height: 380px; padding-inline: 4%; }
    .screen { aspect-ratio: 1.3 / 1; }
    .ekran .screen { width: 92%; }
    .posters a { width: 96px; }
  }
</style>
