---
// Kitap rafı: her kitap bir sırt. Tıklayınca yazısı açılır.
import type { Post } from '../data/content';
interface Props { books: Post[]; }
const { books } = Astro.props;
// Başlığa göre sabit ama farklı boy/kalınlık/renk
const hash = (s: string) => [...s].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
const spines = books.map((b) => {
  const h = hash(b.title);
  return {
    b,
    height: 78 + (h % 22), // % raf yüksekliği
    width: 46 + (h % 5) * 8, // px
    color: b.color ?? `var(--spine-${(h % 5) + 1})`,
    ink: b.color ? '#fff' : `var(--ink-${(h % 5) + 1})`,
  };
});
---
{books.length === 0 ? <p class="empty">Raf şimdilik boş — ilk kitap yazısı gelince burada.</p> : (
  <div class="shelf-wrap"><div class="inner">
    <ul class="shelf" aria-label="Kitaplar">
      {spines.map(({ b, height, width, color, ink }) => (
        <li style={`--h:${height}%;--w:${width}px;--c:${color};--ink:${ink}`}>
          <a href={b.href} target={b.external ? '_blank' : undefined} rel={b.external ? 'noopener' : undefined} title={`${b.title}${b.creator ? ' — ' + b.creator : ''}`}>
            <span class="title">{b.title}</span>
            {b.creator && <span class="author">{b.creator}</span>}
            {b.draft && <span class="draft">taslak</span>}
          </a>
        </li>
      ))}
      <li class="bookend" aria-hidden="true"></li>
    </ul>
    <div class="board" aria-hidden="true"></div>
  </div></div>
)}

<style>
  .shelf-wrap { overflow-x: auto; padding-top: 24px; }
  .inner { min-width: max-content; }
  .shelf {
    list-style: none; margin: 0; padding: 0 24px;
    height: 300px; display: flex; align-items: flex-end; gap: 4px; min-width: max-content;
  }
  .shelf li { height: var(--h); width: var(--w); }
  .shelf a {
    position: relative; display: flex; flex-direction: column; align-items: center; justify-content: space-between;
    height: 100%; width: 100%; padding: 14px 0 12px;
    background: var(--c); color: var(--ink); text-decoration: none;
    border-radius: 3px 3px 1px 1px;
    box-shadow: inset 3px 0 0 rgba(255,255,255,.12), inset -3px 0 0 rgba(0,0,0,.18);
    transform-origin: bottom center;
    transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s;
  }
  /* sırt üstü/altı bant */
  .shelf a::before, .shelf a::after { content: ''; position: absolute; left: 6px; right: 6px; height: 2px; background: currentColor; opacity: .35; }
  .shelf a::before { top: 8px; }
  .shelf a::after { bottom: 34px; }
  .shelf a:hover, .shelf a:focus-visible { transform: translateY(-18px) rotate(-2deg); box-shadow: 0 18px 24px -12px rgba(0,0,0,.4); outline: none; }
  .title, .author { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .title { font-family: var(--font-display); font-weight: 600; font-size: 15px; max-height: 70%; }
  .author { font-family: var(--font-mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; opacity: .75; max-height: 22%; }
  .draft { position: absolute; top: -20px; font-family: var(--font-mono); font-size: 10px; color: var(--muted); }
  .bookend { width: 14px !important; height: 46% !important; background: var(--wood); border-radius: 2px 8px 0 0; opacity: .7; }
  .board { height: 16px; background: var(--wood); border-radius: 2px; box-shadow: 0 10px 18px -10px rgba(0,0,0,.45); }
  @media (prefers-reduced-motion: reduce) { .shelf a { transition: none; } }
</style>
