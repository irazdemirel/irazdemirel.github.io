---
import Avatar from './Avatar.astro';
import { site } from '../data/site';
// İsim harf harf belirir (referans 2); her harf kendi sırasıyla gecikir
const { first, last } = site.name;
const letters = (s: string, start: number) => [...s].map((c, i) => ({ c, i: start + i }));
// Sticker şekilleri + yerleri (% konum, px boyut, süzülme süresi/gecikmesi, açı, renk)
const shapes = {
  yildiz: 'M12 2l2.9 6.1 6.6.8-4.9 4.6 1.3 6.5L12 16.8 6.1 20l1.3-6.5L2.5 8.9l6.6-.8z',
  kalp: 'M12 21s-9-5.6-9-12a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6.4-9 12-9 12z',
  parilti: 'M12 0c1 7 5 11 12 12-7 1-11 5-12 12-1-7-5-11-12-12C7 11 11 7 12 0z',
  cicek: 'M12 8.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zM12 1a4 4 0 0 1 0 8 4 4 0 0 1 0-8zm0 14a4 4 0 0 1 0 8 4 4 0 0 1 0-8zM1 12a4 4 0 0 1 8 0 4 4 0 0 1-8 0zm14 0a4 4 0 0 1 8 0 4 4 0 0 1-8 0z',
} as const;
const stickers: { k: keyof typeof shapes; x: number; y: number; size: number; dur: number; delay: number; rot: number; c: string }[] = [
  { k: 'yildiz', x: 3, y: 10, size: 30, dur: 7, delay: 0, rot: -12, c: 'var(--spine-3)' },
  { k: 'kalp', x: 46, y: 6, size: 24, dur: 6, delay: 1.2, rot: 10, c: 'var(--accent)' },
  { k: 'parilti', x: 40, y: 62, size: 20, dur: 5, delay: .4, rot: 0, c: '#ffd27a' },
  { k: 'cicek', x: 92, y: 88, size: 34, dur: 8, delay: 2, rot: 20, c: 'var(--spine-2)' },
  { k: 'kalp', x: 6, y: 86, size: 20, dur: 6.5, delay: 2.6, rot: -18, c: 'var(--accent-strong)' },
  { k: 'parilti', x: 95, y: 8, size: 18, dur: 4.5, delay: 1.8, rot: 0, c: '#ffd27a' },
  { k: 'yildiz', x: 58, y: 92, size: 22, dur: 7.5, delay: .9, rot: 15, c: 'var(--spine-4)' },
];
---
<section class="hero wrap hero-out" id="top">
  <div class="text">
    <p class="label">Portfolyo · Blog</p>
    <h1 aria-label={`Merhaba, ben ${first} ${last}.`}>
      <span class="hi" aria-hidden="true"><em>Merhaba,</em> ben</span>
      <span class="name" aria-hidden="true">
        <span class="first">{letters(first, 0).map((l) => <span class="ch" style={`--i:${l.i}`}>{l.c}</span>)}</span>
        <span class="last">{letters(last, first.length).map((l) => <span class="ch" style={`--i:${l.i}`}>{l.c}</span>)}</span>
      </span>
    </h1>
    <p class="learning" aria-label="Sıfırdan öğreniyorum.">
      <span aria-hidden="true">Sıfırdan</span><span class="rot" aria-hidden="true"><span class="ghost">&#8203;</span>{site.learning.map((w) => <span class="w">{w}</span>)}</span><span aria-hidden="true">öğreniyorum.</span>
    </p>
    <p class="intro">{site.intro}</p>
    <div class="cta">
      <a href="/projeler/" class="btn">Projeler</a>
      <a href="/blog/" class="btn ghost">Blog</a>
    </div>
  </div>
  <div class="visual">
    <!-- kolaj: avatarın arkasında kareli kâğıt + köşelerde washi bant -->
    <span class="patch" aria-hidden="true"></span>
    <span class="tape t1" aria-hidden="true"></span><span class="tape t2" aria-hidden="true"></span>
    <span class="note" aria-hidden="true">sen<br />yeterlisin ♡</span>
    <div data-speed="0.12"><Avatar /></div>
  </div>
  <!-- Kolaj zemini (referans: referanslar/gorseller/kolaj-kiz.jpeg): kelebek, köpük, papatya, mektuplu güvercin -->
  <div class="collage" aria-hidden="true">
    {[{ x: 40, y: 6, d: 0 }, { x: 36, y: 74, d: -5 }, { x: 86, y: 70, d: -9 }].map((b, i) => (
      <span class={`fly f${i}`} style={`left:${b.x}%;top:${b.y}%;--dl:${b.d}s`}>
        <svg class="butterfly" viewBox="0 0 40 32"><g class="wl"><path d="M20 16 C10 0 0 2 2 12 C3 18 12 18 20 16 Z" /><path d="M20 16 C12 20 4 26 9 30 C14 33 18 24 20 16 Z" /></g><g class="wr"><path d="M20 16 C30 0 40 2 38 12 C37 18 28 18 20 16 Z" /><path d="M20 16 C28 20 36 26 31 30 C26 33 22 24 20 16 Z" /></g><rect x="19" y="8" width="2" height="18" rx="1" fill="#7a4a5c" /></svg>
      </span>
    ))}
    {[12, 30, 47, 70, 84].map((x, i) => <span class="soap" style={`left:${x}%;--s:${14 + (i * 9) % 22}px;--d:${9 + i * 2}s;--dl:${-i * 3}s`}></span>)}
    {[{ x: -1, y: 78, s: 64 }, { x: 4, y: 88, s: 44 }, { x: 94, y: 4, s: 52 }].map((d) => (
      <svg class="daisy" viewBox="0 0 40 40" style={`left:${d.x}%;top:${d.y}%;width:${d.s}px`}>{Array.from({ length: 10 }, (_, i) => <ellipse cx="20" cy="9" rx="4.5" ry="9" transform={`rotate(${i * 36} 20 20)`} />)}<circle cx="20" cy="20" r="5.5" class="mid" /></svg>
    ))}
    <span class="dove-path"><svg class="dove" viewBox="0 0 80 50"><path class="dw" d="M34 22 C30 4 44 0 52 6 C46 12 42 18 40 24 Z" /><path d="M10 30 C20 22 36 20 50 24 C60 22 68 18 74 20 C70 26 62 30 54 32 C42 40 24 40 10 30 Z" /><path d="M10 30 L0 24 L4 34 Z" /><circle cx="66" cy="22" r="1.6" fill="#2a2228" /><rect class="env" x="48" y="32" width="16" height="11" rx="1.5" /><path d="M48 32 l8 6 l8 -6" fill="none" stroke="#d9628a" stroke-width="1.2" /></svg></span>
  </div>
  <!-- Süzülen sticker'lar (referans 4) -->
  <div class="stickers" aria-hidden="true">
    {stickers.map((s) => (
      <svg class:list={['st', s.k]} viewBox="0 0 24 24" style={`left:${s.x}%;top:${s.y}%;--s:${s.size}px;--d:${s.dur}s;--dl:${s.delay}s;--r:${s.rot}deg;--c:${s.c}`}>
        <path d={shapes[s.k]} />
      </svg>
    ))}
  </div>
</section>

<script>
  // Kelimeler birer kez geçer, sonra boşluk kapanır: "Sıfırdan öğreniyorum." (referans: Tiago Feitosa reels'i)
  document.querySelectorAll<HTMLElement>('.rot').forEach((rot) => {
    const words = [...rot.querySelectorAll<HTMLElement>('.w')];
    const close = () => { words.forEach((w) => w.classList.remove('on')); rot.classList.add('closed'); rot.style.width = '0px'; };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { close(); return; }
    let i = 0;
    const show = () => {
      words.forEach((w, j) => w.classList.toggle('on', j === i));
      rot.style.width = words[i].scrollWidth + 'px';
    };
    show();
    const tick = () => {
      i++;
      if (i < words.length) { show(); setTimeout(tick, 1900); }
      else close();
    };
    setTimeout(tick, 1900);
  });
</script>

<style>
  .hero {
    display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 40px;
    min-height: calc(100svh - 64px); padding-block: 40px;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(44px, 7vw, 96px);
    line-height: 0.98; letter-spacing: -0.035em;
    margin: 16px 0 24px;
  }
  h1 > span { display: block; }
  .hi { font-size: 0.5em; font-weight: 300; letter-spacing: -0.02em; margin-bottom: 0.15em; }
  /* Referans 3: bir kelime italik + renkli */
  .hi em { font-style: italic; font-weight: 500; color: var(--accent-strong); }
  .name .first, .name .last { display: inline-block; white-space: nowrap; }
  .name .first { font-weight: 300; margin-right: 0.22em; }
  .name .last { font-weight: 800; }
  .name .ch {
    display: inline-block;
    animation: harf .7s cubic-bezier(.2,.8,.2,1) both;
    animation-delay: calc(250ms + var(--i) * 55ms);
  }
  @keyframes harf {
    from { opacity: 0; transform: translateY(0.35em); filter: blur(6px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .name .ch { animation: none; }
  }
  .learning { font-size: clamp(20px, 2.4vw, 28px); margin: 0 0 16px; }
  .learning { user-select: none; }
  .rot {
    display: inline-block; position: relative; white-space: nowrap; font-weight: 600;
    margin: 0 .28em; transition: width .6s cubic-bezier(.2,.8,.2,1), margin .6s cubic-bezier(.2,.8,.2,1);
  }
  .rot.closed { margin: 0 0 0 .28em; }
  .rot .w {
    position: absolute; left: 0; top: 0; white-space: nowrap;
    opacity: 0; visibility: hidden; transform: translateY(0.5em);
    transition: opacity .4s, transform .4s, visibility 0s .4s;
    text-decoration: underline wavy var(--accent) 2px; text-underline-offset: 6px;
  }
  .rot .w.on { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .rot.closed .w { transform: translateY(-0.5em); }
  .intro { color: var(--muted); max-width: 46ch; margin: 0 0 28px; }
  .cta { display: flex; gap: 16px; flex-wrap: wrap; padding-bottom: 8px; }
  /* Butonlar = basılınca çöken klavye tuşları (iletişimdekilerle aynı) */
  .btn {
    --k: var(--accent); --depth: 6px;
    text-decoration: none; padding: 12px 24px; border-radius: 14px; font-weight: 700;
    background: var(--k); color: #2a2228;
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, .4),
      0 var(--depth) 0 color-mix(in srgb, var(--k) 68%, #2a2228),
      0 calc(var(--depth) + 10px) 20px -10px rgba(42, 34, 40, .45);
    transition: transform .08s ease-out, box-shadow .08s ease-out;
    -webkit-tap-highlight-color: transparent;
  }
  .btn.ghost { --k: var(--spine-2); }
  .btn:hover { color: #2a2228; --depth: 8px; transform: translateY(-2px); }
  .btn:active { --depth: 1px; transform: translateY(5px); }
  .btn:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 4px; }

  /* Sticker'lar: arkada yavaşça süzülür, döner */
  .hero { position: relative; isolation: isolate; }
  .text, .visual { position: relative; z-index: 1; }

  /* Kolaj zemini: puantiyeli pembe kâğıt kart */
  .hero::before {
    content: ''; position: absolute; inset: 16px calc(-1 * var(--bleed)); z-index: -1; border-radius: 36px;
    background:
      radial-gradient(circle, rgba(255,255,255,.75) 1.6px, transparent 2.2px) 0 0 / 24px 24px,
      linear-gradient(135deg, #fde8ee, #f8d6e1 55%, #f4e2ea);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.6), 0 30px 60px -40px rgba(160,60,100,.45);
  }
  :global([data-theme='dark']) .hero::before {
    background: radial-gradient(circle, rgba(255,255,255,.07) 1.6px, transparent 2.2px) 0 0 / 24px 24px, linear-gradient(135deg, #2e2228, #34252c 55%, #2b2026);
  }
  /* kart kenar boşluğuna taşar, yazılar diğer bölümlerle aynı sol çizgide kalır */
  .hero { --bleed: clamp(10px, (100vw - 100%) / 2 - 14px, 32px); }
  .collage { position: absolute; inset: 16px calc(-1 * var(--bleed)); z-index: 0; pointer-events: none; overflow: hidden; border-radius: 36px; }

  /* Kareli kâğıt + bant + not */
  .patch {
    position: absolute; inset: 4% 2% 2% 6%; z-index: -1; rotate: 5deg; border-radius: 6px;
    background:
      repeating-linear-gradient(0deg, rgba(140,190,140,.35) 0 14px, transparent 14px 28px),
      repeating-linear-gradient(90deg, rgba(140,190,140,.35) 0 14px, transparent 14px 28px), #f4f8ee;
    box-shadow: 0 14px 30px -18px rgba(80,90,60,.5);
  }
  .tape { position: absolute; z-index: 3; width: 110px; height: 30px; background: repeating-linear-gradient(45deg, rgba(247,168,192,.85) 0 8px, rgba(255,214,226,.85) 8px 16px); box-shadow: 0 2px 4px rgba(0,0,0,.08); }
  .t1 { top: 4%; left: 2%; rotate: -32deg; }
  .t2 { bottom: 6%; right: 0; rotate: -28deg; }
  .note {
    position: absolute; z-index: 3; top: -2%; right: -2%; padding: 12px 14px 14px; width: 116px;
    background: #fff3b8; color: #6a5a3a; font: italic 600 16px/1.2 var(--font-display); text-align: center;
    box-shadow: 0 10px 16px -8px rgba(90,70,30,.4); rotate: 8deg; transform-origin: top center;
    animation: not-sallan 5s ease-in-out infinite;
  }
  .note::before { content: ''; position: absolute; top: -10px; left: 50%; width: 16px; height: 16px; margin-left: -8px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #ff9ab6, #d9628a); box-shadow: 0 2px 3px rgba(0,0,0,.25); }
  @keyframes not-sallan { 50% { rotate: 3deg; } }

  /* Kelebekler: kanat çırpar, süzülür */
  .fly { position: absolute; animation: kelebek 14s ease-in-out var(--dl) infinite; }
  .butterfly { width: 58px; overflow: visible; }
  .butterfly path { fill: #f7a8c0; stroke: #fff; stroke-width: 1; }
  .butterfly .wl, .butterfly .wr { transform-origin: 20px 16px; animation: kanat .35s ease-in-out infinite alternate; }
  .butterfly .wr { animation-name: kanat-r; }
  @keyframes kanat { to { transform: scaleX(.25); } }
  @keyframes kanat-r { to { transform: scaleX(.25); } }
  @keyframes kelebek { 0%, 100% { transform: translate(0, 0) rotate(-8deg); } 25% { transform: translate(60px, -30px) rotate(6deg); } 50% { transform: translate(110px, 10px) rotate(-4deg); } 75% { transform: translate(40px, 30px) rotate(10deg); } }

  /* Sabun köpükleri: gökkuşağı yansımalı, yükselir */
  .soap {
    position: absolute; bottom: -40px; width: var(--s); height: var(--s); border-radius: 50%;
    background: radial-gradient(circle at 30% 28%, rgba(255,255,255,.95) 0 12%, transparent 22%), radial-gradient(circle, transparent 55%, rgba(185,163,214,.45) 68%, rgba(156,197,192,.5) 80%, rgba(255,255,255,.8) 92%);
    animation: kopuk var(--d) linear var(--dl) infinite;
  }
  @keyframes kopuk { 0% { transform: translate(0, 0); opacity: 0; } 10% { opacity: 1; } 50% { transform: translate(24px, -50vh); } 100% { transform: translate(-10px, -105vh); opacity: .2; } }

  /* Papatyalar */
  .daisy { position: absolute; fill: #fff; filter: drop-shadow(0 3px 4px rgba(120,60,80,.18)); animation: papatya 8s ease-in-out infinite alternate; }
  .daisy .mid { fill: #f7c95c; }
  @keyframes papatya { to { rotate: 18deg; } }

  /* Mektuplu güvercin: ekranı yavaşça geçer */
  .dove-path { position: absolute; top: 8%; left: -12%; animation: guvercin 26s linear infinite; }
  .dove { width: 84px; fill: #fff; filter: drop-shadow(0 6px 6px rgba(120,60,80,.2)); overflow: visible; animation: suzul-k 2s ease-in-out infinite; }
  .dove .dw { fill: #f3eef2; transform-origin: 40px 24px; animation: dove-kanat .5s ease-in-out infinite alternate; }
  .dove .env { fill: #fff6f9; stroke: #d9628a; stroke-width: 1.2; }
  @keyframes guvercin { to { transform: translateX(125vw); } }
  @keyframes suzul-k { 50% { translate: 0 -10px; } }
  @keyframes dove-kanat { to { transform: scaleY(-.6); } }
  .stickers { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .st {
    position: absolute; width: var(--s); height: var(--s); fill: var(--c);
    filter: drop-shadow(0 4px 6px rgba(120, 60, 80, .2));
    animation: sticker var(--d) ease-in-out var(--dl) infinite;
    rotate: var(--r);
  }
  .st.parilti { filter: drop-shadow(0 0 6px rgba(255, 210, 122, .8)); }
  @keyframes sticker {
    0%, 100% { transform: translateY(0) rotate(0deg) scale(1); }
    50% { transform: translateY(-14px) rotate(12deg) scale(1.08); }
  }
  @media (prefers-reduced-motion: reduce) {
    .st, .note, .fly, .butterfly .wl, .butterfly .wr, .daisy, .dove, .dove .dw { animation: none; }
    .soap, .dove-path { display: none; }
    .btn { transition: none; }
    .btn:hover { transform: none; }
  }
  @media (max-width: 820px) {
    .st { width: calc(var(--s) * .7); height: calc(var(--s) * .7); }
    .tape { width: 64px; height: 20px; }
    .note { width: 92px; font-size: 13px; padding: 10px; }
    .daisy:not(:last-of-type) { display: none; }
    .learning { font-size: 18px; }
    .fly.f1 { display: none; }
    .fly.f0 { top: 46% !important; left: 70% !important; }
    .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 24px; }
    .visual { order: -1; max-width: 300px; width: 70%; margin-inline: auto; }
  }
</style>
