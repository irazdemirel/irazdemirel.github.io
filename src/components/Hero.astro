---
import Avatar from './Avatar.astro';
import { site } from '../data/site';
---
<section class="hero wrap hero-out" id="top">
  <div class="text">
    <p class="label">Portfolyo · Blog</p>
    <h1>
      <span class="thin">Merhaba, ben {site.name.first}</span>
      <span class="bold">{site.name.last}.</span>
    </h1>
    <p class="learning">
      Sıfırdan
      <span class="sr">{site.learning.join(' ve ')}</span>
      <span class="rot" aria-hidden="true">
        <span class="ghost">&#8203;</span>
        {site.learning.map((w, i) => <span class="w" data-step={i} aria-hidden="true">{w}</span>)}
        <span class="w final" aria-hidden="true">
          {site.learning.map((w, i) => <>{i > 0 && <span class="ve">ve</span>}<span class:list={['part', `p${i}`]}>{w}</span></>)}
        </span>
      </span>
      öğreniyorum.
    </p>
    <p class="intro">{site.intro}</p>
    <div class="cta">
      <a href="/projeler/" class="btn">Projeler</a>
      <a href="/blog/" class="btn ghost">Blog</a>
    </div>
  </div>
  <div class="visual"><div data-speed="0.12"><Avatar /></div></div>
</section>

<script>
  // Kelimeler sırayla döner, sonunda tek cümlede birleşir (referans: Tiago Feitosa reels'i)
  document.querySelectorAll<HTMLElement>('.rot').forEach((rot) => {
    const steps = [...rot.querySelectorAll<HTMLElement>('.w')]; // son eleman: final
    const show = (el: HTMLElement) => {
      steps.forEach((x) => x.classList.toggle('on', x === el));
      rot.style.width = el.scrollWidth + 'px';
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { show(steps[steps.length - 1]); return; }
    let i = 0;
    show(steps[0]);
    const next = () => {
      i++;
      show(steps[i]);
      if (i < steps.length - 1) setTimeout(next, 1800);
      else rot.classList.add('merged');
    };
    setTimeout(next, 1800);
    addEventListener('resize', () => show(steps[i]));
  });
</script>

<style>
  .hero {
    display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 40px;
    min-height: calc(100svh - 64px); padding-block: 40px;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(44px, 7vw, 96px);
    line-height: 0.98; letter-spacing: -0.035em;
    margin: 16px 0 24px;
  }
  h1 span { display: block; }
  .thin { font-weight: 300; }
  .bold { font-weight: 700; }
  .learning { font-size: clamp(20px, 2.4vw, 28px); margin: 0 0 16px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .rot {
    display: inline-block; position: relative; overflow: visible;
    font-weight: 600; transition: width .5s cubic-bezier(.2,.8,.2,1); white-space: nowrap;
  }
  .rot .w {
    position: absolute; left: 0; top: 0; white-space: nowrap;
    opacity: 0; transform: translateY(0.5em); transition: opacity .4s, transform .4s;
    text-decoration: underline wavy var(--muted) 1px; text-underline-offset: 6px;
  }
  .rot .w.on { opacity: 1; transform: none; }
  .rot .final { text-decoration: none; }
  .final .part { display: inline-block; text-decoration: underline wavy var(--muted) 1px; text-underline-offset: 6px; transition: transform .7s cubic-bezier(.2,.8,.2,1); }
  .final .ve { display: inline-block; padding: 0 .3em; font-weight: 400; opacity: 0; transition: opacity .5s .35s; }
  .final:not(.on) .p0 { transform: translateX(-40%); }
  .final:not(.on) .p1 { transform: translateX(40%); }
  .merged .final .ve { opacity: 1; }
  .intro { color: var(--muted); max-width: 46ch; margin: 0 0 28px; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn {
    text-decoration: none; padding: 12px 22px; border-radius: 999px;
    background: var(--accent); color: var(--accent-contrast); font-weight: 500;
    border: 1px solid var(--accent);
  }
  .btn.ghost { background: transparent; color: var(--text); border-color: var(--line); }
  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 24px; }
    .visual { order: -1; max-width: 300px; width: 70%; margin-inline: auto; }
  }
</style>
