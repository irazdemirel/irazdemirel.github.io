---
import Avatar from './Avatar.astro';
import { site } from '../data/site';
// İsim harf harf belirir (referans 2); her harf kendi sırasıyla gecikir
const { first, last } = site.name;
const letters = (s: string, start: number) => [...s].map((c, i) => ({ c, i: start + i }));
// Sticker şekilleri + yerleri (% konum, px boyut, süzülme süresi/gecikmesi, açı, renk)
const shapes = {
  yildiz: 'M12 2l2.9 6.1 6.6.8-4.9 4.6 1.3 6.5L12 16.8 6.1 20l1.3-6.5L2.5 8.9l6.6-.8z',
  kalp: 'M12 21s-9-5.6-9-12a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6.4-9 12-9 12z',
  parilti: 'M12 0c1 7 5 11 12 12-7 1-11 5-12 12-1-7-5-11-12-12C7 11 11 7 12 0z',
  cicek: 'M12 8.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zM12 1a4 4 0 0 1 0 8 4 4 0 0 1 0-8zm0 14a4 4 0 0 1 0 8 4 4 0 0 1 0-8zM1 12a4 4 0 0 1 8 0 4 4 0 0 1-8 0zm14 0a4 4 0 0 1 8 0 4 4 0 0 1-8 0z',
} as const;
const stickers: { k: keyof typeof shapes; x: number; y: number; size: number; dur: number; delay: number; rot: number; c: string }[] = [
  { k: 'yildiz', x: 3, y: 10, size: 30, dur: 7, delay: 0, rot: -12, c: 'var(--spine-3)' },
  { k: 'kalp', x: 46, y: 6, size: 24, dur: 6, delay: 1.2, rot: 10, c: 'var(--accent)' },
  { k: 'parilti', x: 40, y: 62, size: 20, dur: 5, delay: .4, rot: 0, c: '#ffd27a' },
  { k: 'cicek', x: 92, y: 88, size: 34, dur: 8, delay: 2, rot: 20, c: 'var(--spine-2)' },
  { k: 'kalp', x: 6, y: 86, size: 20, dur: 6.5, delay: 2.6, rot: -18, c: 'var(--accent-strong)' },
  { k: 'parilti', x: 95, y: 8, size: 18, dur: 4.5, delay: 1.8, rot: 0, c: '#ffd27a' },
  { k: 'yildiz', x: 58, y: 92, size: 22, dur: 7.5, delay: .9, rot: 15, c: 'var(--spine-4)' },
];
---
<section class="hero wrap hero-out" id="top">
  <div class="text">
    <p class="label">Portfolyo · Blog</p>
    <h1 aria-label={`Merhaba, ben ${first} ${last}.`}>
      <span class="hi" aria-hidden="true"><em>Merhaba,</em> ben</span>
      <span class="name" aria-hidden="true">
        <span class="first">{letters(first, 0).map((l) => <span class="ch" style={`--i:${l.i}`}>{l.c}</span>)}</span>
        <span class="last">{letters(last, first.length).map((l) => <span class="ch" style={`--i:${l.i}`}>{l.c}</span>)}</span>
      </span>
    </h1>
    <p class="learning" aria-label="Sıfırdan öğreniyorum.">
      <span aria-hidden="true">Sıfırdan</span><span class="rot" aria-hidden="true"><span class="ghost">&#8203;</span>{site.learning.map((w) => <span class="w">{w}</span>)}</span><span aria-hidden="true">öğreniyorum.</span>
    </p>
    <p class="intro">{site.intro}</p>
    <div class="cta">
      <a href="/projeler/" class="btn">Projeler</a>
      <a href="/blog/" class="btn ghost">Blog</a>
    </div>
  </div>
  <div class="visual"><div data-speed="0.12"><Avatar /></div></div>
  <!-- Süzülen sticker'lar (referans 4) -->
  <div class="stickers" aria-hidden="true">
    {stickers.map((s) => (
      <svg class:list={['st', s.k]} viewBox="0 0 24 24" style={`left:${s.x}%;top:${s.y}%;--s:${s.size}px;--d:${s.dur}s;--dl:${s.delay}s;--r:${s.rot}deg;--c:${s.c}`}>
        <path d={shapes[s.k]} />
      </svg>
    ))}
  </div>
</section>

<script>
  // Kelimeler birer kez geçer, sonra boşluk kapanır: "Sıfırdan öğreniyorum." (referans: Tiago Feitosa reels'i)
  document.querySelectorAll<HTMLElement>('.rot').forEach((rot) => {
    const words = [...rot.querySelectorAll<HTMLElement>('.w')];
    const close = () => { words.forEach((w) => w.classList.remove('on')); rot.classList.add('closed'); rot.style.width = '0px'; };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { close(); return; }
    let i = 0;
    const show = () => {
      words.forEach((w, j) => w.classList.toggle('on', j === i));
      rot.style.width = words[i].scrollWidth + 'px';
    };
    show();
    const tick = () => {
      i++;
      if (i < words.length) { show(); setTimeout(tick, 1900); }
      else close();
    };
    setTimeout(tick, 1900);
  });
</script>

<style>
  .hero {
    display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 40px;
    min-height: calc(100svh - 64px); padding-block: 40px;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(44px, 7vw, 96px);
    line-height: 0.98; letter-spacing: -0.035em;
    margin: 16px 0 24px;
  }
  h1 > span { display: block; }
  .hi { font-size: 0.5em; font-weight: 300; letter-spacing: -0.02em; margin-bottom: 0.15em; }
  /* Referans 3: bir kelime italik + renkli */
  .hi em { font-style: italic; font-weight: 500; color: var(--accent-strong); }
  .name .first, .name .last { display: inline-block; white-space: nowrap; }
  .name .first { font-weight: 300; margin-right: 0.22em; }
  .name .last { font-weight: 800; }
  .name .ch {
    display: inline-block;
    animation: harf .7s cubic-bezier(.2,.8,.2,1) both;
    animation-delay: calc(250ms + var(--i) * 55ms);
  }
  @keyframes harf {
    from { opacity: 0; transform: translateY(0.35em); filter: blur(6px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .name .ch { animation: none; }
  }
  .learning { font-size: clamp(20px, 2.4vw, 28px); margin: 0 0 16px; }
  .learning { user-select: none; }
  .rot {
    display: inline-block; position: relative; white-space: nowrap; font-weight: 600;
    margin: 0 .28em; transition: width .6s cubic-bezier(.2,.8,.2,1), margin .6s cubic-bezier(.2,.8,.2,1);
  }
  .rot.closed { margin: 0 0 0 .28em; }
  .rot .w {
    position: absolute; left: 0; top: 0; white-space: nowrap;
    opacity: 0; visibility: hidden; transform: translateY(0.5em);
    transition: opacity .4s, transform .4s, visibility 0s .4s;
    text-decoration: underline wavy var(--accent) 2px; text-underline-offset: 6px;
  }
  .rot .w.on { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .rot.closed .w { transform: translateY(-0.5em); }
  .intro { color: var(--muted); max-width: 46ch; margin: 0 0 28px; }
  .cta { display: flex; gap: 16px; flex-wrap: wrap; padding-bottom: 8px; }
  /* Butonlar = basılınca çöken klavye tuşları (iletişimdekilerle aynı) */
  .btn {
    --k: var(--accent); --depth: 6px;
    text-decoration: none; padding: 12px 24px; border-radius: 14px; font-weight: 700;
    background: var(--k); color: #2a2228;
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, .4),
      0 var(--depth) 0 color-mix(in srgb, var(--k) 68%, #2a2228),
      0 calc(var(--depth) + 10px) 20px -10px rgba(42, 34, 40, .45);
    transition: transform .08s ease-out, box-shadow .08s ease-out;
    -webkit-tap-highlight-color: transparent;
  }
  .btn.ghost { --k: var(--spine-2); }
  .btn:hover { color: #2a2228; --depth: 8px; transform: translateY(-2px); }
  .btn:active { --depth: 1px; transform: translateY(5px); }
  .btn:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 4px; }

  /* Sticker'lar: arkada yavaşça süzülür, döner */
  .hero { position: relative; }
  .text, .visual { position: relative; z-index: 1; }
  .stickers { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .st {
    position: absolute; width: var(--s); height: var(--s); fill: var(--c);
    filter: drop-shadow(0 4px 6px rgba(120, 60, 80, .2));
    animation: sticker var(--d) ease-in-out var(--dl) infinite;
    rotate: var(--r);
  }
  .st.parilti { filter: drop-shadow(0 0 6px rgba(255, 210, 122, .8)); }
  @keyframes sticker {
    0%, 100% { transform: translateY(0) rotate(0deg) scale(1); }
    50% { transform: translateY(-14px) rotate(12deg) scale(1.08); }
  }
  @media (prefers-reduced-motion: reduce) {
    .st { animation: none; }
    .btn { transition: none; }
    .btn:hover { transform: none; }
  }
  @media (max-width: 820px) {
    .st { width: calc(var(--s) * .7); height: calc(var(--s) * .7); }
    .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 24px; }
    .visual { order: -1; max-width: 300px; width: 70%; margin-inline: auto; }
  }
</style>
