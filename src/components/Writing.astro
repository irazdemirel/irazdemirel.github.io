---
/*
  "Yazıyorum": 3D retro bilgisayar (React Three Fiber adası, görününce yüklenir).
  Altındaki terminal kartı gerçek linkleri taşır: 3D hazır olana kadar / WebGL yoksa görünür,
  3D hazır olunca görsel olarak gizlenir ama ekran okuyucular için yerinde kalır.
*/
import RetroComputer from './three/RetroComputer';
import { fmtDate, type Post } from '../data/content';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
const prompt = 'C:\\IRAZ\\YAZILAR> dir';
const empty = '0 dosya bulundu · ilk yazı yakında';
---
<div class="pc3d">
  <RetroComputer client:visible posts={posts.map((p) => ({ title: p.title, date: fmtDate(p.date) }))} empty={empty} prompt={prompt} />
  <div class="term">
    <p class="prompt" aria-hidden="true">{prompt}</p>
    {posts.length === 0 ? (
      <p class="muted">{empty}</p>
    ) : (
      <ol>
        {posts.map((p, i) => (
          <li>
            <a href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <span class="t">{p.title}{p.external && <span aria-label="Medium'da açılır"> ↗</span>}</span>
              <span class="d">{fmtDate(p.date)}</span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </div>
</div>

<style>
  .pc3d { position: relative; height: clamp(400px, 48vw, 620px); }
  .pc3d :global(.pc3d-canvas) { position: absolute; inset: 0; }
  /* Fallback / ekran okuyucu: terminal kartı */
  .term {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: min(560px, 100%);
    padding: 24px 28px; border-radius: 22px; background: var(--3d-screen); color: var(--3d-screen-text);
    font-family: var(--font-mono); font-size: 14px; box-shadow: var(--shadow);
    transition: opacity .5s;
  }
  .term p { margin: 0 0 10px; }
  .term .muted { opacity: .75; }
  .term ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .term a { display: grid; grid-template-columns: 2.5em 1fr auto; gap: 12px; color: inherit; text-decoration: none; }
  .term a:hover .t, .term a:focus-visible .t { text-decoration: underline; }
  .term .n, .term .d { opacity: .55; }
  /* 3D hazır: kart görünmez olur ama erişilebilir kalır; klavye odağında tekrar görünür */
  .pc3d:global(.ready) .term { opacity: 0; pointer-events: none; }
  .pc3d:global(.ready) .term:focus-within { opacity: 1; pointer-events: auto; }
</style>
