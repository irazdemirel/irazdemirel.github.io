---
// Tek proje kartı. comingSoon: true ise tıklanmaz, "Çok yakında" yazar.
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projeler'>; index: number; heading?: 'h2' | 'h3'; }
const { project: p, index, heading = 'h3' } = Astro.props;
const soon = p.data.comingSoon;
const Tag = soon ? 'div' : 'a';
const H = heading;
const label = soon ? 'Çok yakında' : p.data.status;
---
<Tag class:list={['pc', { soon }]} data-tilt href={soon ? undefined : `/projeler/${p.id}/`} aria-disabled={soon ? 'true' : undefined}>
  <div class="cover">
    {p.data.cover ? <img src={p.data.cover} alt="" loading="lazy" decoding="async" fetchpriority="low" /> : <span class="num">{String(index + 1).padStart(2, '0')}</span>}
    {soon && <span class="badge label">Çok yakında</span>}
  </div>
  <div class="meta">
    <span class="label">{label}{p.data.draft ? ' · TASLAK' : ''}</span>
    <H class="t">{p.data.title}</H>
    <p>{p.data.summary}</p>
  </div>
</Tag>

<style>
  /* data-tilt: motion.ts kartı imlece göre eğer; kapak öne çıkar (derinlik), parlama imleci izler */
  .pc { text-decoration: none; display: block; color: inherit; position: relative; transform-style: preserve-3d; }
  .pc::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; opacity: 0;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 30%), rgba(255,255,255,.45), transparent 55%);
    transition: opacity .4s;
  }
  .cover {
    position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius); background: var(--surface); overflow: hidden;
    display: grid; place-items: center; box-shadow: var(--shadow);
    transition: transform .45s cubic-bezier(.2,.8,.2,1), box-shadow .45s;
  }
  .cover img { width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; }
  /* Üzerine gelince hafifçe büyür (referans 5); sadece fareli cihazlarda */
  @media (hover: hover) {
    .pc:hover .cover { transform: translateZ(28px) scale(1.02); box-shadow: 0 28px 50px -24px rgba(120, 60, 80, 0.45); }
    .pc:hover::after { opacity: 1; }
  }
  a.pc:focus-visible { outline: none; }
  a.pc:focus-visible .cover { outline: 2px solid var(--accent-strong); outline-offset: 4px; }
  a.pc:hover .t { text-decoration: underline; text-underline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) {
    .cover { transition: none; }
    .pc:hover .cover { transform: none; }
  }
  .num { font-family: var(--font-display); font-size: 72px; font-weight: 300; color: var(--line); }
  .soon { cursor: default; }
  .badge {
    position: absolute; top: 12px; left: 12px; padding: 6px 10px; border-radius: 999px;
    background: var(--accent-soft); color: var(--text); border: 1px solid var(--accent);
  }
  .meta { padding-top: 14px; }
  .t { margin: 6px 0 4px; font-size: 22px; letter-spacing: -0.01em; }
  p { margin: 0; color: var(--muted); font-size: 15px; }
</style>
