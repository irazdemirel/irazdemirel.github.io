---
// Yatay kaydırılan proje kartları (referans: Kumo "Selected works")
import type { CollectionEntry } from 'astro:content';
interface Props { projects: CollectionEntry<'projeler'>[]; }
const { projects } = Astro.props;
---
{projects.length === 0 ? (
  <p class="empty">İlk projeler yakında burada.</p>
) : (
  <ul class="strip">
    {projects.map((p, i) => (
      <li class="card reveal">
        <a href={`/projeler/${p.id}/`}>
          <div class="cover">
            {p.data.cover ? <img src={p.data.cover} alt="" loading="lazy" /> : <span class="num">{String(i + 1).padStart(2, '0')}</span>}
          </div>
          <div class="meta">
            <span class="label">{p.data.status}{p.data.draft ? ' · TASLAK' : ''}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.summary}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .strip {
    list-style: none; margin: 0; padding: 0 0 16px;
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(280px, 380px); gap: 20px;
    overflow-x: auto; scroll-snap-type: x mandatory;
  }
  .card { scroll-snap-align: start; }
  .card a { text-decoration: none; display: block; }
  .cover {
    aspect-ratio: 4 / 3; border-radius: var(--radius); background: var(--surface); overflow: hidden;
    display: grid; place-items: center; transition: transform 0.4s;
  }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .card a:hover .cover { transform: scale(0.98); }
  .num { font-family: var(--font-display); font-size: 72px; font-weight: 300; color: var(--line); }
  .meta { padding-top: 14px; }
  h3 { margin: 6px 0 4px; font-size: 22px; letter-spacing: -0.01em; }
  p { margin: 0; color: var(--muted); font-size: 15px; }
</style>
