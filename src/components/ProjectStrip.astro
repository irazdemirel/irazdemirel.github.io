---
// Yatay kaydırılan proje kartları (referans: Kumo "Selected works")
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
interface Props { projects: CollectionEntry<'projeler'>[]; }
const { projects } = Astro.props;
---
{projects.length === 0 ? (
  <p class="empty">İlk projeler yakında burada.</p>
) : (
  <ul class="strip">
    {projects.map((p, i) => <li class="reveal"><ProjectCard project={p} index={i} /></li>)}
  </ul>
)}

<style>
  .strip {
    /* üst/yan boşluk: büyüyen kart kesilmesin */
    list-style: none; margin: -12px -12px 0; padding: 12px 12px 16px; scroll-padding-inline: 12px;
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(280px, 380px); gap: 20px;
    overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory;
    scrollbar-width: thin; scrollbar-color: var(--accent) transparent;
  }
  li { scroll-snap-align: start; }
  /* Masaüstü yatay kaydırma (motion.ts → projectsScroll): şeridi GSAP kaydırır, kartlar genişler */
  :global(.h-scroll) .strip { overflow: visible; scroll-snap-type: none; grid-auto-columns: clamp(300px, 30vw, 460px); will-change: transform; }
</style>
