---
// Yatay kaydırılan proje kartları (referans: Kumo "Selected works")
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
interface Props { projects: CollectionEntry<'projeler'>[]; }
const { projects } = Astro.props;
---
{projects.length === 0 ? (
  <p class="empty">İlk projeler yakında burada.</p>
) : (
  <ul class="strip">
    {projects.map((p, i) => <li class="reveal"><ProjectCard project={p} index={i} /></li>)}
  </ul>
)}

<style>
  .strip {
    list-style: none; margin: 0; padding: 0 0 16px;
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(280px, 380px); gap: 20px;
    overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory;
  }
  li { scroll-snap-align: start; }
</style>
