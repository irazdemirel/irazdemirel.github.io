---
/*
  İmleci takip eden avatar. Öncelik sırası:
  1. 3 poz (referans: DeuOaVaNGnc reels'i): public/avatar/poz-sol|orta|sag.webp varsa
     imlecin bulunduğu bölge (sol / orta / sağ üçte bir) → o poz, yumuşak geçişle.
     Kaynaklar referanslar/avatar/sol.png… → `npm run avatar` webp'ye çevirir (bkz. README).
  2. Kareler: site.ts → avatar.frames > 0 ise frame-01.webp … (imlecin yatay konumu → kare).
  3. Tek görsel, 4. yer tutucu.
*/
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { site } from '../data/site';
const { frames, pattern, alt, image, poses } = site.avatar;
const hasPoses = poses.every((p) => existsSync(join(process.cwd(), 'public', p)));
const pad = (n: number) => String(n).padStart(2, '0');
const srcs = hasPoses ? [] : Array.from({ length: frames }, (_, i) => pattern.replace('{n}', pad(i + 1)));
const mid = srcs[Math.floor(frames / 2)];
---
<div class="avatar" data-frames={JSON.stringify(srcs)}>
  {hasPoses ? (
    <div class="tilt poses">
      {poses.map((p, i) => (
        <img class:list={['pose', { on: i === 1 }]} src={p} alt={i === 1 ? alt : ''} aria-hidden={i === 1 ? undefined : 'true'} width="640" height="640" fetchpriority={i === 1 ? 'high' : undefined} />
      ))}
      <span class="shine" aria-hidden="true" />
    </div>
  ) : frames > 0 ? (
    <div class="tilt"><img class="still" src={mid} alt={alt} width="560" height="560" fetchpriority="high" /><span class="shine" aria-hidden="true" /></div>
  ) : image ? (
    <div class="tilt"><img class="still" src={image} alt={alt} width="800" height="800" fetchpriority="high" /><span class="shine" aria-hidden="true" /></div>
  ) : (
    <div class="placeholder" role="img" aria-label="Avatar yakında">
      <svg viewBox="0 0 200 200" aria-hidden="true">
        <g class="head">
          <circle cx="100" cy="78" r="38" />
          <g class="eyes"><circle cx="87" cy="78" r="4" /><circle cx="113" cy="78" r="4" /></g>
        </g>
        <path d="M38 196c4-44 30-66 62-66s58 22 62 66z" />
      </svg>
      <span class="label">Avatar yakında</span>
    </div>
  )}
</div>

<script>
  // Tek rAF döngüsü + yaylı yumuşatma: kare (bakış), eğilme, mıknatıs kayması ve parlama birlikte hareket eder.
  // Sonuç --mx / --my (-1..1) olarak .avatar'a yazılır; CSS ve 3D halka (HeroRing) bunları okur.
  document.querySelectorAll<HTMLElement>('.avatar').forEach((root) => {
    const srcs: string[] = JSON.parse(root.dataset.frames || '[]');
    const poses = [...root.querySelectorAll<HTMLImageElement>('.pose')];
    const img = poses.length ? null : root.querySelector('img');
    const eyes = root.querySelector<SVGGElement>('.eyes');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const touch = matchMedia('(hover: none)').matches;

    // Kareler: bir kez belleğe çözülür (ImageBitmap), sonra canvas'a çizilir.
    // <img src> değiştirmek her karede yeniden çözme = takılma yapıyordu.
    // Açılışı yavaşlatmasın: sayfa yüklendikten hemen sonra (ya da ilk fare hareketinde) iner.
    let bitmaps: ImageBitmap[] = [];
    let ctx: CanvasRenderingContext2D | null = null;
    let started = false, drawn = -1;
    const loadFrames = () => {
      if (started || !img || !srcs.length || !('createImageBitmap' in window)) return;
      started = true;
      Promise.all(srcs.map((s) => fetch(s).then((r) => r.blob()).then((b) => createImageBitmap(b))))
        .then((bmps) => {
          bitmaps = bmps;
          const c = document.createElement('canvas');
          c.width = bmps[0].width; c.height = bmps[0].height;
          c.className = 'still';
          c.setAttribute('role', 'img');
          c.setAttribute('aria-label', img.alt);
          ctx = c.getContext('2d');
          img.replaceWith(c);
          drawn = -1; kick(true);
        })
        .catch(() => {}); // olmazsa tek kare kalır, eğilme yine çalışır
    };
    window.addEventListener('pointermove', loadFrames, { once: true, passive: true });
    const soon = () => setTimeout(loadFrames, 600);
    if (document.readyState === 'complete') soon(); else window.addEventListener('load', soon, { once: true });

    // 3 poz: 0 = sol, 1 = orta, 2 = sağ. Sınırda titremesin diye küçük pay (hysteresis).
    let pose = 1;
    const setPose = (n: number) => {
      if (n === pose) return;
      pose = n;
      poses.forEach((p, i) => p.classList.toggle('on', i === n));
    };
    const poseFor = (t: number) => {
      const pad = 0.04;
      if (pose === 0) return t > 1 / 3 + pad ? (t > 2 / 3 ? 2 : 1) : 0;
      if (pose === 2) return t < 2 / 3 - pad ? (t < 1 / 3 ? 0 : 1) : 2;
      return t < 1 / 3 - pad ? 0 : t > 2 / 3 + pad ? 2 : 1;
    };

    // hedef (tx, ty) → şu anki (x, y); kare başına üstel yaklaşma, ekran tazeleme hızından bağımsız
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0, last = 0;
    const frame = (now: number) => {
      const dt = last ? Math.min(0.05, (now - last) / 1000) : 0;
      last = now;
      const k = 1 - Math.exp(-dt * 11);
      x += (tx - x) * k; y += (ty - y) * k;
      const t = (x + 1) / 2; // 0 = sol, 1 = sağ
      if (ctx) {
        const f = Math.round(t * (bitmaps.length - 1));
        if (f !== drawn) { ctx.drawImage(bitmaps[f], 0, 0, ctx.canvas.width, ctx.canvas.height); drawn = f; }
      }
      if (poses.length) setPose(poseFor(t));
      if (eyes) eyes.style.transform = `translateX(${x * 6}px)`;
      root.style.setProperty('--mx', x.toFixed(4));
      root.style.setProperty('--my', y.toFixed(4));
      if (Math.abs(tx - x) + Math.abs(ty - y) > 0.001) raf = requestAnimationFrame(frame);
      else { raf = 0; last = 0; }
    };
    const kick = (force = false) => {
      if (force) drawn = -1;
      if (!raf) raf = requestAnimationFrame(frame);
    };
    const clamp = (v: number) => Math.max(-1, Math.min(1, v));
    // İmleç avatarın merkezine göre: yanında küçük bir hareket bile başı çevirir,
    // ~1.2 avatar genişliği uzakta tam yana bakar.
    const aim = (cx: number, cy: number) => {
      const r = root.getBoundingClientRect();
      const s = Math.max(r.width * 1.2, 280);
      tx = clamp((cx - (r.left + r.width / 2)) / s);
      ty = clamp((cy - (r.top + r.height / 2)) / s);
      kick();
    };
    const center = () => { tx = 0; ty = 0; kick(); };

    if (!touch) {
      window.addEventListener('pointermove', (e) => aim(e.clientX, e.clientY), { passive: true });
      document.documentElement.addEventListener('pointerleave', center);
    } else if (poses.length) {
      // Dokunmatik: orta pozda durur; ekranın bir yanına dokununca 2 sn o yöne bakar
      let back = 0;
      window.addEventListener('pointerdown', (e) => {
        aim(e.clientX, e.clientY);
        clearTimeout(back);
        back = window.setTimeout(center, 2000);
      }, { passive: true });
    } else if (srcs.length) {
      // Dokunmatik + kareler: avatar arada bir yavaşça etrafına bakar (sadece ekrandayken)
      let on = false, start = 0;
      const idle = (ts: number) => {
        if (!on) return;
        if (!start) start = ts;
        const p = ((ts - start) / 7000) % 1; // 7 sn'lik döngü
        tx = p < 0.6 ? 0 : 0.9 * Math.sin(((p - 0.6) / 0.4) * Math.PI * 2);
        ty = p < 0.6 ? 0 : -0.15 * Math.sin(((p - 0.6) / 0.4) * Math.PI);
        kick();
        requestAnimationFrame(idle);
      };
      new IntersectionObserver(([en]) => {
        on = en.isIntersecting;
        if (on) { start = 0; requestAnimationFrame(idle); }
      }).observe(root);
    }
  });
</script>

<style>
  .avatar { --mx: 0; --my: 0; aspect-ratio: 1; width: 100%; max-width: 520px; margin-inline: auto; }
  .avatar img { width: 100%; height: 100%; object-fit: contain; }
  .avatar { perspective: 900px; position: relative; animation: suzul 6s ease-in-out infinite; }
  @keyframes suzul { 50% { transform: translateY(-10px); } }

  /* Disk: imlece doğru birkaç px kayar ve hafifçe eğilir (geçiş yok: değerleri JS yay ile yumuşatıyor) */
  .tilt {
    position: relative; width: 100%; height: 100%; border-radius: 50%; overflow: hidden;
    box-shadow: var(--shadow), 0 0 0 10px var(--accent-soft);
    transform:
      translate3d(calc(var(--mx) * 12px), calc(var(--my) * 10px), 0)
      rotateX(calc(var(--my) * -7deg)) rotateY(calc(var(--mx) * 9deg));
    will-change: transform;
    transition: scale .6s cubic-bezier(.16,1,.3,1);
    animation: belir .9s cubic-bezier(.16,1,.3,1) backwards; /* bitince scale'i bırakır (hover çalışsın) */
  }
  /* Açılış: disk yumuşakça büyüyerek belirir */
  @keyframes belir { from { opacity: 0; scale: .88; } }
  .avatar:hover .tilt { scale: 1.03; }
  .tilt .still { object-fit: cover; transform: scale(1.06); }
  /* canvas JS ile eklenir, scoped stil almaz → :global */
  .tilt :global(canvas.still) { display: block; width: 100%; height: 100%; transform: scale(1.06); }
  /* 3 poz üst üste; görünen poz yumuşakça belirir */
  .pose { position: absolute; inset: 0; object-fit: cover; opacity: 0; transition: opacity .35s ease; }
  .pose.on { opacity: 1; }
  /* Parlama: imleci izleyen yumuşak ışık lekesi (sadece transform) */
  .shine {
    position: absolute; inset: -50%; pointer-events: none;
    background: radial-gradient(circle at 50% 50%, rgba(255,255,255,.26), rgba(255,255,255,.08) 22%, transparent 40%);
    transform: translate(calc(var(--mx) * 22%), calc(var(--my) * 22% - 14%));
    opacity: .75; transition: opacity .6s;
  }
  .avatar:hover .shine { opacity: 1; }
  .placeholder {
    width: 100%; height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, var(--accent-soft), var(--surface) 70%);
    display: grid; place-items: center; position: relative; overflow: hidden;
  }
  .placeholder svg { width: 70%; fill: var(--line); }
  .placeholder .eyes { fill: var(--muted); }
  .placeholder .label { position: absolute; bottom: 12%; }
  @media (prefers-reduced-motion: reduce) {
    .avatar, .tilt { animation: none; }
    .tilt { transition: none; }
    .avatar:hover .tilt { scale: none; }
    .pose { transition: none; }
  }
</style>
