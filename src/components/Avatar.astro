---
/*
  İmleci takip eden avatar. Öncelik sırası:
  1. 3 poz (referans: DeuOaVaNGnc reels'i): public/avatar/poz-sol|orta|sag.webp varsa
     imlecin bulunduğu bölge (sol / orta / sağ üçte bir) → o poz, yumuşak geçişle.
     Kaynaklar referanslar/avatar/sol.png… → `npm run avatar` webp'ye çevirir (bkz. README).
  2. Kareler: site.ts → avatar.frames > 0 ise frame-01.webp … (imlecin yatay konumu → kare).
  3. Tek görsel, 4. yer tutucu.
*/
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { site } from '../data/site';
const { frames, pattern, alt, image, poses } = site.avatar;
const hasPoses = poses.every((p) => existsSync(join(process.cwd(), 'public', p)));
const pad = (n: number) => String(n).padStart(2, '0');
const srcs = hasPoses ? [] : Array.from({ length: frames }, (_, i) => pattern.replace('{n}', pad(i + 1)));
const mid = srcs[Math.floor(frames / 2)];
---
<div class="avatar" data-frames={JSON.stringify(srcs)}>
  {hasPoses ? (
    <div class="tilt poses">
      {poses.map((p, i) => (
        <img class:list={['pose', { on: i === 1 }]} src={p} alt={i === 1 ? alt : ''} aria-hidden={i === 1 ? undefined : 'true'} width="640" height="640" fetchpriority={i === 1 ? 'high' : undefined} />
      ))}
      <span class="shine" aria-hidden="true" />
    </div>
  ) : frames > 0 ? (
    <div class="tilt"><img class="still" src={mid} alt={alt} width="560" height="560" fetchpriority="high" /><span class="shine" aria-hidden="true" /></div>
  ) : image ? (
    <div class="tilt"><img class="still" src={image} alt={alt} width="800" height="800" fetchpriority="high" /><span class="shine" aria-hidden="true" /></div>
  ) : (
    <div class="placeholder" role="img" aria-label="Avatar yakında">
      <svg viewBox="0 0 200 200" aria-hidden="true">
        <g class="head">
          <circle cx="100" cy="78" r="38" />
          <g class="eyes"><circle cx="87" cy="78" r="4" /><circle cx="113" cy="78" r="4" /></g>
        </g>
        <path d="M38 196c4-44 30-66 62-66s58 22 62 66z" />
      </svg>
      <span class="label">Avatar yakında</span>
    </div>
  )}
  <!-- Süs: dönen inci halkası + yörüngede parıldayan yıldız/kalpler -->
  <div class="deco" aria-hidden="true">
    <svg class="pearls" viewBox="0 0 100 100"><circle cx="50" cy="50" r="48.5" /></svg>
    <div class="orbit">
      <svg class="spark s1" viewBox="0 0 24 24"><path d="M12 0c1 7 5 11 12 12-7 1-11 5-12 12-1-7-5-11-12-12C7 11 11 7 12 0z" /></svg>
      <svg class="heart h1" viewBox="0 0 24 24"><path d="M12 21s-9-5.6-9-12a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6.4-9 12-9 12z" /></svg>
      <svg class="spark s2" viewBox="0 0 24 24"><path d="M12 0c1 7 5 11 12 12-7 1-11 5-12 12-1-7-5-11-12-12C7 11 11 7 12 0z" /></svg>
      <svg class="heart h2" viewBox="0 0 24 24"><path d="M12 21s-9-5.6-9-12a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6.4-9 12-9 12z" /></svg>
      <svg class="spark s3" viewBox="0 0 24 24"><path d="M12 0c1 7 5 11 12 12-7 1-11 5-12 12-1-7-5-11-12-12C7 11 11 7 12 0z" /></svg>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.avatar').forEach((root) => {
    const srcs: string[] = JSON.parse(root.dataset.frames || '[]');
    const poses = [...root.querySelectorAll<HTMLImageElement>('.pose')];
    const img = poses.length ? null : root.querySelector('img');
    const eyes = root.querySelector<SVGGElement>('.eyes');
    const tilt = root.querySelector<HTMLElement>('.tilt');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const touch = matchMedia('(hover: none)').matches;

    // Kareleri önden yükle
    srcs.forEach((s) => { const i = new Image(); i.src = s; });

    // 3 poz: 0 = sol, 1 = orta, 2 = sağ. Sınırda titremesin diye küçük pay (hysteresis).
    let pose = 1;
    const setPose = (n: number) => {
      if (n === pose) return;
      pose = n;
      poses.forEach((p, i) => p.classList.toggle('on', i === n));
    };
    const poseFor = (t: number) => {
      const pad = 0.04;
      if (pose === 0) return t > 1 / 3 + pad ? (t > 2 / 3 ? 2 : 1) : 0;
      if (pose === 2) return t < 2 / 3 - pad ? (t < 1 / 3 ? 0 : 1) : 2;
      return t < 1 / 3 - pad ? 0 : t > 2 / 3 + pad ? 2 : 1;
    };

    let raf = 0;
    let y = window.innerHeight / 2;
    const update = (x: number) => {
      const t = Math.min(1, Math.max(0, x / window.innerWidth)); // 0 = sol, 1 = sağ
      if (poses.length) setPose(poseFor(t));
      if (img && srcs.length) {
        const src = srcs[Math.round(t * (srcs.length - 1))];
        if (img.getAttribute('src') !== src) img.setAttribute('src', src);
      }
      if (tilt) {
        // imlece doğru hafif 3D dönüş (kare/poz varsa daha az)
        tilt.style.setProperty('--rx', `${((y / window.innerHeight) - 0.5) * -10}deg`);
        tilt.style.setProperty('--ry', `${(t - 0.5) * (srcs.length || poses.length ? 8 : 22)}deg`);
        tilt.style.setProperty('--sx', `${t * 100}%`);
      } else if (eyes) {
        eyes.style.transform = `translateX(${(t - 0.5) * 12}px)`;
      }
    };
    if (!touch) {
      window.addEventListener('pointermove', (e) => {
        cancelAnimationFrame(raf);
        y = e.clientY;
        raf = requestAnimationFrame(() => update(e.clientX));
      }, { passive: true });
      document.addEventListener('pointerleave', () => update(window.innerWidth / 2));
    } else if (poses.length) {
      // Dokunmatik: orta pozda durur; ekranın bir yanına dokununca 2 sn o yöne bakar
      let back = 0;
      window.addEventListener('pointerdown', (e) => {
        update(e.clientX);
        clearTimeout(back);
        back = window.setTimeout(() => update(window.innerWidth / 2), 2000);
      }, { passive: true });
    } else if (srcs.length) {
      // Dokunmatik + kareler: avatar arada bir yavaşça etrafına bakar
      let start = 0;
      const loop = (ts: number) => {
        if (!start) start = ts;
        const p = ((ts - start) / 7000) % 1; // 7 sn'lik döngü
        const t = p < 0.6 ? 0.5 : 0.5 + 0.45 * Math.sin(((p - 0.6) / 0.4) * Math.PI * 2);
        update(t * window.innerWidth);
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  });
</script>

<style>
  .avatar { aspect-ratio: 1; width: 100%; max-width: 520px; margin-inline: auto; }
  .avatar img { width: 100%; height: 100%; object-fit: contain; }
  .avatar { perspective: 900px; position: relative; animation: suzul 6s ease-in-out infinite; }
  @keyframes suzul { 50% { transform: translateY(-10px); } }

  /* Süsler */
  .deco { position: absolute; inset: -7%; pointer-events: none; }
  .pearls { position: absolute; inset: 0; width: 100%; height: 100%; animation: don 40s linear infinite; overflow: visible; }
  .pearls circle { fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-linecap: round; stroke-dasharray: 0 4.2; }
  .orbit { position: absolute; inset: 0; animation: don 24s linear infinite reverse; }
  .orbit svg { position: absolute; width: 7%; transform: translate(-50%, -50%); overflow: visible; }
  .spark { fill: #ffd27a; filter: drop-shadow(0 0 6px rgba(255, 210, 122, .8)); animation: pirilti 2.4s ease-in-out infinite; }
  .heart { fill: var(--accent-strong); width: 6% !important; animation: kalp 1.8s ease-in-out infinite; }
  .s1 { left: 50%; top: 0; }
  .h1 { left: 93%; top: 25%; }
  .s2 { left: 93%; top: 75%; width: 5% !important; animation-delay: .8s; }
  .h2 { left: 7%; top: 75%; animation-delay: .6s; }
  .s3 { left: 7%; top: 25%; width: 4.5% !important; animation-delay: 1.5s; }
  @keyframes don { to { transform: rotate(360deg); } }
  @keyframes pirilti { 0%, 100% { opacity: .35; scale: .6; } 50% { opacity: 1; scale: 1.1; } }
  @keyframes kalp { 0%, 100% { scale: 1; } 15% { scale: 1.25; } 30% { scale: 1; } 45% { scale: 1.15; } }
  .tilt {
    position: relative; width: 100%; height: 100%; border-radius: 50%; overflow: hidden;
    box-shadow: var(--shadow), 0 0 0 10px var(--accent-soft);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform .35s cubic-bezier(.2,.8,.2,1);
    transform-style: preserve-3d;
  }
  .tilt .still { object-fit: cover; transform: scale(1.06); }
  /* 3 poz üst üste; görünen poz yumuşakça belirir */
  .pose { position: absolute; inset: 0; object-fit: cover; opacity: 0; transition: opacity .35s ease; }
  .pose.on { opacity: 1; }
  .shine { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at var(--sx, 50%) 20%, rgba(255,255,255,.28), transparent 55%); mix-blend-mode: soft-light; }
  .placeholder {
    width: 100%; height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, var(--accent-soft), var(--surface) 70%);
    display: grid; place-items: center; position: relative; overflow: hidden;
  }
  .placeholder svg { width: 70%; fill: var(--line); }
  .placeholder .eyes { fill: var(--muted); transition: transform 0.25s ease-out; }
  .placeholder .label { position: absolute; bottom: 12%; }
  @media (prefers-reduced-motion: reduce) {
    .avatar, .pearls, .orbit, .spark, .heart { animation: none; }
    .pose { transition: none; }
  }
</style>
