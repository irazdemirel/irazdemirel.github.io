---
import { site, nav } from '../data/site';
import Lamp from './Lamp.astro';
const path = Astro.url.pathname;
---
<header class="hdr">
  <div class="wrap row">
    <a href="/" class="logo">{site.name.first} <b>{site.name.last}</b></a>
    <div class="end">
      <nav aria-label="Ana menü">
        {nav.map((n) => (
          <a href={n.href} class="label" aria-current={path.startsWith(n.href) && n.href !== '/' && !n.href.includes('#') ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <Lamp />
    </div>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(10px); }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; }
  .logo { text-decoration: none; font-family: var(--font-display); font-weight: 300; font-size: 18px; letter-spacing: -0.01em; white-space: nowrap; }
  .logo b { font-weight: 700; }
  .end { display: flex; align-items: center; gap: 20px; }
  /* Kumo: küçük, sütunlar halinde nav */
  nav { display: grid; grid-template-columns: repeat(5, auto); column-gap: 28px; }
  nav a { text-decoration: none; color: var(--text); }
  nav a:hover, nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 560px) {
    /* Dar ekran: 1. satır logo + lamba, 2. satır nav */
    .row { flex-wrap: wrap; row-gap: 0; min-height: 56px; padding-bottom: 8px; }
    .end { display: contents; }
    nav { order: 3; flex-basis: 100%; grid-template-columns: repeat(3, auto); justify-content: space-between; column-gap: 8px; row-gap: 4px; }
    nav a { font-size: 11px; }
  }
</style>
