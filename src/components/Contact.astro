---
/*
  İletişim tuşları (referans 3: basılınca çöken klavye tuşları).
  - Masaüstü: 3D tuşlar (three/ContactKeys, sadece geniş ekranda yüklenir). Gerçek linkler
    tuşların üstünde şeffaf hücreler olarak kalır: klavye, sağ tık, ekran okuyucu çalışır.
  - Mobil / 3D yüklenene kadar / WebGL yoksa: CSS tuşları.
*/
import ContactKeys from './three/ContactKeys';
interface Props { contacts: { label: string; href: string; text: string }[]; }
const { contacts } = Astro.props;
---
<div class="keys3d" style={`--n:${contacts.length}`}>
  <ContactKeys client:media="(min-width: 761px)" items={contacts.map(({ label, text }) => ({ label, text }))} />
  <ul class="keys">
    {contacts.map((c, i) => (
      <li class="reveal">
        <a class="key" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener" style={`--k:var(--spine-${(i % 5) + 1});--ki:var(--ink-${(i % 5) + 1})`}>
          <span class="k-label">{c.label} <span aria-hidden="true">↗</span></span>
          <span class="k-text">{c.text}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  // iOS'ta :active (tuş basılı hali) dokunmada da çalışsın
  document.querySelectorAll('.key').forEach((k) => k.addEventListener('touchstart', () => {}, { passive: true }));
</script>

<style>
  .keys3d { position: relative; }
  .keys3d :global(.keys3d-canvas) { position: absolute; inset: 0; pointer-events: none; }
  /* Klavye tuşları: üst yüz + altta koyu "kalınlık" gölgesi; basınca tuş iner */
  .keys { position: relative; z-index: 1; list-style: none; margin: 0; padding: 0 0 8px; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 20px 16px; }
  .key {
    --depth: 7px;
    display: flex; flex-direction: column; gap: 2px; height: 100%; padding: 18px 20px 20px;
    border-radius: 14px; text-decoration: none; color: var(--ki); background: var(--k);
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, .35),
      inset 0 -3px 0 rgba(0, 0, 0, .06),
      0 var(--depth) 0 color-mix(in srgb, var(--k) 68%, #2a2228),
      0 calc(var(--depth) + 10px) 22px -10px rgba(42, 34, 40, .45);
    transform: translateY(0);
    transition: transform .08s ease-out, box-shadow .08s ease-out;
    -webkit-tap-highlight-color: transparent;
  }
  .key:hover { color: var(--ki); --depth: 9px; transform: translateY(-2px); }
  .key:active { --depth: 2px; transform: translateY(5px); }
  .key:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 4px; }
  .k-label { font-family: var(--font-display); font-weight: 700; font-size: 20px; letter-spacing: -0.01em; }
  .k-text { font-family: var(--font-mono); font-size: 12px; opacity: .75; overflow-wrap: anywhere; }

  /* Masaüstü: 3D sahnenin yeri baştan ayrılır (yüklenince sayfa zıplamasın) */
  @media (min-width: 761px) {
    .keys3d { height: clamp(220px, 19vw, 260px); display: grid; align-items: center; }
  }
  /* 3D hazır: linkler tuşların üstünde şeffaf hücre; yazılar ekran okuyucu için yerinde */
  .keys3d.ready .keys { position: absolute; inset: 0; padding: 0; gap: 16px; grid-template-columns: repeat(var(--n), 1fr); }
  .keys3d.ready li { opacity: 1 !important; visibility: visible !important; transform: none !important; }
  .keys3d.ready .key { background: transparent; box-shadow: none; transform: none; border-radius: 22px; }
  .keys3d.ready .key > * { opacity: 0; }

  @media (prefers-reduced-motion: reduce) {
    .key { transition: none; }
    .key:hover { transform: none; }
  }
  @media (max-width: 760px) {
    .keys { grid-template-columns: 1fr 1fr; gap: 16px 12px; }
    .keys li:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .key { padding: 14px 14px 16px; }
    .k-text { font-size: 10.5px; }
  }
</style>
