---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../data/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---
<Base title={d.title} description={d.summary}>
  <article class="section wrap">
    <a href="/projeler/" class="label back">← Projeler</a>
    <p class="label">{d.status}</p>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <dl class="facts">
      {d.stack.length > 0 && <div><dt class="label">Teknolojiler</dt><dd>{d.stack.join(' · ')}</dd></div>}
      {d.repo && <div><dt class="label">Kod</dt><dd><a href={d.repo} target="_blank" rel="noopener">GitHub ↗</a></dd></div>}
      {d.demo && <div><dt class="label">Demo</dt><dd><a href={d.demo} target="_blank" rel="noopener">Aç ↗</a></dd></div>}
    </dl>
    {d.cover && <img class="cover" src={d.cover} alt="" />}
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .back { text-decoration: none; display: inline-block; margin-bottom: 32px; }
  h1 { font-family: var(--font-display); font-size: clamp(36px, 6vw, 72px); line-height: 1; letter-spacing: -0.03em; margin: 12px 0 16px; }
  .lede { font-size: 20px; color: var(--muted); max-width: 680px; margin: 0 0 32px; }
  .facts { display: flex; flex-wrap: wrap; gap: 32px; margin: 0 0 40px; padding: 20px 0; border-block: 1px solid var(--line); }
  dd { margin: 4px 0 0; }
  .cover { border-radius: var(--radius); margin-bottom: 40px; }
</style>
