---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../data/content';
const projects = await getProjects();
---
<Base title="Projeler" description="Üzerinde çalıştığım ve tamamladığım projeler.">
  <section class="section wrap">
    <h1 class="section-title" data-split>Projeler</h1>
    {projects.length === 0 ? <p class="empty">İlk projeler yakında burada.</p> : (
      <ul class="grid">
        {projects.map((p, i) => <li class="reveal"><ProjectCard project={p} index={i} heading="h2" /></li>)}
      </ul>
    )}
  </section>
</Base>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 32px 24px; }
</style>
