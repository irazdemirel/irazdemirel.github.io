---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectStrip from '../components/ProjectStrip.astro';
import RetroPC from '../components/RetroPC.astro';
import Aquarium from '../components/Aquarium.astro';
import Heatmap from '../components/Heatmap.astro';
import { site } from '../data/site';
import { getPosts, getProjects } from '../data/content';

const projects = await getProjects();
const posts = (await getPosts()).slice(0, 5);
const l = site.links;
const contacts = [
  l.email && { label: 'E-posta', href: `mailto:${l.email}`, text: l.email },
  l.linkedin && { label: 'LinkedIn', href: l.linkedin, text: 'linkedin.com/in/irazdemirel' },
  l.github && { label: 'GitHub', href: l.github, text: 'github.com/irazdemirel' },
  l.kaggle && { label: 'Kaggle', href: l.kaggle, text: l.kaggle.replace(/^https?:\/\/(www\.)?/, '') },
  l.medium && { label: 'Medium', href: l.medium, text: l.medium.replace(/^https?:\/\//, '') },
  l.instagram && { label: 'Instagram', href: l.instagram, text: 'Instagram' },
  l.tiktok && { label: 'TikTok', href: l.tiktok, text: 'TikTok' },
].filter(Boolean) as { label: string; href: string; text: string }[];
---
<Base>
  <Hero />

  <!-- Büyük cümle solda, bir konunun yolculuğu sağda zaman çizelgesi olarak -->
  <!-- Masaüstünde bölüm pinlenir; kaydırdıkça çizgi dolar ve adımlar sırayla yanar (motion.ts) -->
  <section class="statement section" data-pin-steps>
    <div class="wrap grid">
      <h2 class="big" data-split>{site.statement.big.map((s) => <span>{s}</span>)}</h2>
      <ol class="timeline">
        <!-- Kaydırdıkça çizgide aşağı yüzen balık + baloncuklar -->
        <li class="swimmer" aria-hidden="true">
          <svg class="fish" viewBox="0 0 64 40">
            <path class="tail" d="M14 20 L0 6 Q4 20 0 34 Z" />
            <ellipse cx="34" cy="20" rx="22" ry="15" />
            <path class="fin" d="M30 6 Q36 -2 42 7 Z" />
            <circle cx="46" cy="16" r="4" fill="#fff" /><circle cx="47" cy="16" r="2" fill="#2a2228" />
            <circle cx="40" cy="24" r="2.6" fill="#f7a8c0" opacity=".8" />
          </svg>
          <span class="bub b1"></span><span class="bub b2"></span><span class="bub b3"></span>
        </li>
        {site.statement.steps.map((st, i) => (
          <li class="step" style={`--c:var(--spine-${(i % 4) + 1})`}>
            <span class="dot" aria-hidden="true">{['✎', '¶', '▶', '★'][i % 4]}</span>
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <h3>{st.t}</h3>
            <p>{st.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="projeler">
    <div class="wrap">
      <!-- Balık zaman çizelgesinin sonunda bu akvaryuma düşer -->
      <Aquarium>
        <div class="head">
          <h2 class="section-title" data-split>Projeler</h2>
          <a href="/projeler/" class="label">Tümü →</a>
        </div>
        <ProjectStrip projects={projects} />
      </Aquarium>
    </div>
  </section>

  <section class="section" id="blog">
    <div class="wrap">
      <div class="head">
        <h2 class="section-title" data-split>Yazıyorum</h2>
        <a href="/blog/" class="label">Tümü →</a>
      </div>
      <div class="reveal"><RetroPC posts={posts} /></div>
    </div>
  </section>

  <section class="section" id="calisiyorum">
    <div class="wrap">
      <h2 class="section-title" data-split>Çalışıyorum</h2>
      <p class="sub reveal">Her kare bir gün. GitHub’a kod yüklediğim günler koyulaşıyor.</p>
      <div class="reveal"><Heatmap /></div>
    </div>
  </section>

  <section class="section" id="iletisim">
    <div class="wrap">
      <h2 class="section-title" data-split>İletişim</h2>
      <!-- Referans 3: basılınca çöken klavye tuşları (Faz 3'te gerçek 3D) -->
      <ul class="keys">
        {contacts.map((c, i) => (
          <li class="reveal" style={`transition-delay:${i * 70}ms`}>
            <a class="key" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener" style={`--k:var(--spine-${(i % 5) + 1});--ki:var(--ink-${(i % 5) + 1})`}>
              <span class="k-label">{c.label} <span aria-hidden="true">↗</span></span>
              <span class="k-text">{c.text}</span>
            </a>
          </li>
        ))}
      </ul>
      <script>
        // iOS'ta :active (tuş basılı hali) dokunmada da çalışsın
        document.querySelectorAll('.key').forEach((k) => k.addEventListener('touchstart', () => {}, { passive: true }));
      </script>
    </div>
  </section>
</Base>

<style>
  .statement .grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 56px; align-items: center; }
  .big {
    margin: 0;
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(44px, 7.2vw, 112px); line-height: 0.92; letter-spacing: -0.04em;
  }
  /* harflere bölününce kerning kaybolur, kelime biraz genişler: satır kırılmasın */
  .big span { display: block; white-space: nowrap; }
  .big span:last-child { font-weight: 300; color: var(--accent-strong); }
  /* Zaman çizelgesi: çizgi kaydırdıkça dolar (--p, GSAP sürer). Hareket yoksa dolu durur. */
  .timeline { list-style: none; margin: 0; padding: 0 0 0 36px; position: relative; --p: 1; }
  :global(.motion) .timeline { --p: 0; }
  .timeline::before, .timeline::after { content: ''; position: absolute; left: 7px; top: 10px; bottom: 10px; width: 2px; border-radius: 2px; }
  .timeline::before { background: var(--line); }
  .timeline::after {
    background: linear-gradient(var(--spine-1), var(--spine-2), var(--spine-3), var(--spine-4));
    transform-origin: top; transform: scaleY(var(--p)); width: 4px; left: 6px;
  }
  .timeline li.step { position: relative; padding-bottom: 44px; }
  .timeline li:last-child { padding-bottom: 0; }
  /* Adımların ve noktaların girişi motion.ts'te (GSAP timeline) */
  .dot {
    position: absolute; left: -46px; top: -2px; width: 36px; height: 36px; border-radius: 50%;
    display: grid; place-items: center; font-size: 16px; color: #2a2228;
    background: var(--c); border: 3px solid var(--bg);
    box-shadow: 0 6px 14px -6px color-mix(in srgb, var(--c) 70%, #2a2228), inset 0 2px 0 rgba(255,255,255,.5);
  }
  .step h3 { transition: transform .3s cubic-bezier(.34,1.56,.64,1), color .3s; transform-origin: left; }
  .step:hover h3 { transform: rotate(-2deg) scale(1.05); color: var(--accent-strong); }
  .step:hover .dot { animation: hopla .5s cubic-bezier(.34,1.56,.64,1); }
  @keyframes hopla { 50% { translate: 0 -8px; scale: 1.15; } }

  /* Yüzen balık: çizgide --p (kaydırma ilerlemesi) kadar aşağıda */
  .swimmer {
    position: absolute; left: -15px; top: calc(var(--p) * (100% - 52px));
    width: 46px; height: 52px; z-index: 2; pointer-events: none;
    /* sona gelince kaybolur: akvaryuma "düşer" */
    opacity: clamp(0, (1 - var(--p)) * 12, 1);
    translate: 0 calc(max(0, var(--p) - .9) * 400px);
  }
  .fish { width: 46px; rotate: 90deg; fill: var(--accent); overflow: visible; filter: drop-shadow(0 4px 6px rgba(120,60,80,.3)); animation: yuz 1.6s ease-in-out infinite; }
  .fish .tail { fill: var(--accent-strong); transform-origin: 14px 20px; animation: kuyruk .4s ease-in-out infinite alternate; }
  .fish .fin { fill: var(--accent-strong); }
  @keyframes yuz { 50% { translate: 4px 0; } }
  @keyframes kuyruk { to { transform: scaleY(.6) rotate(8deg); } }
  .bub { position: absolute; left: 12px; top: 0; width: 8px; height: 8px; border-radius: 50%; border: 1.5px solid var(--spine-4); background: rgba(255,255,255,.4); opacity: 0; animation: baloncuk 2.4s ease-out infinite; }
  .b2 { width: 6px; height: 6px; left: 20px; animation-delay: .8s; }
  .b3 { width: 10px; height: 10px; left: 6px; animation-delay: 1.6s; }
  @keyframes baloncuk { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: 1; } 100% { transform: translate(10px, -60px); opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .step:hover .dot, .fish, .fish .tail, .bub { animation: none; }
    .bub { display: none; }
  }
  .timeline h3 { font-family: var(--font-display); font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -0.02em; margin: 4px 0 4px; }
  .timeline p { margin: 0; color: var(--muted); }
  .sub { color: var(--muted); margin: -24px 0 28px; max-width: 52ch; }
  /* Akvaryum kutusunun kendi iç boşluğu var; üstte bölüm boşluğu daha az */
  #projeler { padding-top: clamp(40px, 5vw, 72px); }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .head a { text-decoration: none; white-space: nowrap; }
  /* Klavye tuşları: üst yüz + altta koyu "kalınlık" gölgesi; basınca tuş iner */
  .keys { list-style: none; margin: 0; padding: 0 0 8px; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 20px 16px; }
  .key {
    --depth: 7px;
    display: flex; flex-direction: column; gap: 2px; height: 100%; padding: 18px 20px 20px;
    border-radius: 14px; text-decoration: none; color: var(--ki); background: var(--k);
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, .35),
      inset 0 -3px 0 rgba(0, 0, 0, .06),
      0 var(--depth) 0 color-mix(in srgb, var(--k) 68%, #2a2228),
      0 calc(var(--depth) + 10px) 22px -10px rgba(42, 34, 40, .45);
    transform: translateY(0);
    transition: transform .08s ease-out, box-shadow .08s ease-out;
    -webkit-tap-highlight-color: transparent;
  }
  .key:hover { color: var(--ki); --depth: 9px; transform: translateY(-2px); }
  .key:active { --depth: 2px; transform: translateY(5px); }
  .key:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 4px; }
  .k-label { font-family: var(--font-display); font-weight: 700; font-size: 20px; letter-spacing: -0.01em; }
  .k-text { font-family: var(--font-mono); font-size: 12px; opacity: .75; overflow-wrap: anywhere; }
  @media (prefers-reduced-motion: reduce) {
    .key { transition: none; }
    .key:hover { transform: none; }
  }
  @media (max-width: 760px) {
    .statement .grid { grid-template-columns: 1fr; gap: 40px; }
    .big { position: static; }
    .keys { grid-template-columns: 1fr 1fr; gap: 16px 12px; }
    .keys li:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .key { padding: 14px 14px 16px; }
    .k-text { font-size: 10.5px; }
  }
</style>
